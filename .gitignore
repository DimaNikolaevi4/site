# === Артефакты сборки Eleventy ===
public/
_site/
.eleventycache

# === Зависимости ===
node_modules/
package-lock.json
yarn.lock

# === Переменные окружения ===
.env
.env.local
.env.*
!.env.example

# === Логи и отчёты ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.nyc_output/
coverage/
.jest-cache/

# === Кэш и временные файлы ===
.cache/
.parcel-cache/
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# === Редакторы и IDE ===
.vscode/
.idea/
*.sublime-*

# === Операционные системы ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# === Python (если используется) ===
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
.coverage
htmlcov/

# === Локальные конфиги ===
config.local.js
eleventy.config.local.js

# === Загруженные пользователями файлы ===
src/assets/uploads/*
!src/assets/uploads/.gitkeep

# === Директория /mirror — источник контента, не деплоится на хостинг ===
/mirror/

# === Служебные файлы хостинга ===
.htpasswd
*.user.ini