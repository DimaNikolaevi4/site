<!DOCTYPE html>
<html lang="{{ site.lang }}" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ site.title }}{% if title %} | {{ title }}{% endif %}</title>
  <meta name="description" content="{{ site.description }}{% if description %} — {{ description }}{% endif %}">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png">
  <link rel="shortcut icon" href="/favicons/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/favicons/favicon.png">
  
  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site.url }}{{ page.url | url }}">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
  <meta property="og:title" content="{{ site.title }}{% if title %} | {{ title }}{% endif %}">
  <meta property="og:description" content="{{ site.description }}{% if description %} — {{ description }}{% endif %}">
  <meta property="og:image" content="{{ site.url }}/assets/images/og-image.jpg">
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content="{{ site.url }}{{ page.url | url }}">
  <meta name="twitter:title" content="{{ site.title }}{% if title %} | {{ title }}{% endif %}">
  <meta name="twitter:description" content="{{ site.description }}{% if description %} — {{ description }}{% endif %}">
  <meta name="twitter:image" content="{{ site.url }}/assets/images/og-image.jpg">
  
  <!-- Bootstrap 5 CSS + Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.0/font/bootstrap-icons.min.css">
  
  <link rel="stylesheet" href="/assets/css/style.css">
  <script>
    // Prevent FOUC by applying accessibility settings immediately
    (function() {
      var savedSettings = localStorage.getItem('a11y-settings');
      if (savedSettings) {
        try {
          var settings = JSON.parse(savedSettings);
          if (settings.enabled) {
            document.documentElement.classList.add('a11y-enabled');
            if (settings.largeFont) document.documentElement.classList.add('a11y-large-font');
            if (settings.highContrast) document.documentElement.classList.add('a11y-high-contrast');
            if (settings.noAnimations) document.documentElement.classList.add('a11y-no-animations');
          }
        } catch(e) {}
      }
    })();
  </script>
</head>
<body>
  <!-- Баннер разработки -->
  <div class="dev-banner">
    <div class="container dev-banner-content">
      <span class="dev-banner-text">⚠️ Сайт находится в режиме тестирования и разработки.</span>
      <a href="https://sit-salsk.ru/ " target="_blank" rel="noopener" class="dev-banner-link">Перейти на основной сайт →</a>
    </div>
  </div>

  <!-- Skip to main content link for accessibility -->
  <a href="#main-content" class="skip-link">Перейти к основному содержанию</a>
  
  <!-- Accessibility toggle button -->
  <button 
    type="button" 
    class="a11y-toggle" 
    id="a11yToggle" 
    aria-label="Версия для слабовидящих"
    aria-expanded="false"
    aria-controls="a11yPanel"
  >
    <span class="a11y-toggle-icon">👁</span>
    <span class="a11y-toggle-text">Версия для слабовидящих</span>
  </button>
  
  <!-- Accessibility settings panel -->
  <div class="a11y-panel" id="a11yPanel" role="region" aria-labelledby="a11yToggle" hidden>
    <div class="a11y-panel-content">
      <h3 id="a11y-panel-title">Настройки доступности</h3>
      <div class="a11y-options">
        <label class="a11y-option">
          <input type="checkbox" id="a11yLargeFont" aria-describedby="a11y-large-font-desc">
          <span>Крупный шрифт</span>
        </label>
        <span id="a11y-large-font-desc" class="visually-hidden">Увеличивает размер шрифта на странице</span>
        
        <label class="a11y-option">
          <input type="checkbox" id="a11yHighContrast" aria-describedby="a11y-high-contrast-desc">
          <span>Высокая контрастность</span>
        </label>
        <span id="a11y-high-contrast-desc" class="visually-hidden">Включает режим высокой контрастности цветов</span>
        
        <label class="a11y-option">
          <input type="checkbox" id="a11yNoAnimations" aria-describedby="a11y-no-animations-desc">
          <span>Отключить анимации</span>
        </label>
        <span id="a11y-no-animations-desc" class="visually-hidden">Отключает все анимации и переходы</span>
      </div>
      <button type="button" class="a11y-reset" id="a11yReset">Сбросить настройки</button>
      <button type="button" class="a11y-close" id="a11yClose">Закрыть</button>
    </div>
  </div>
  
  {% include "partials/header.njk" %}
  <main class="site-main" id="main-content" tabindex="-1">
    {% block content %}
    {% if fullWidth %}
      {{ content | safe }}
    {% else %}
      <div class="page-body">
        {{ content | safe }}
      </div>
    {% endif %}
    {% endblock %}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/assets/js/main.js"></script>
  <script src="/assets/js/slider.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/header.js"></script>
</body>
</html>
