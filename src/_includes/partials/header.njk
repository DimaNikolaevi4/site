{# Шапка сайта ГБПОУ РО «СИТ» - адаптивная, с поддержкой доступности #}

<header class="site-header">
  <div class="container">
    
    <!-- ВЕРХНЯЯ СТРОКА: логотип, название, герб -->
    <div class="header-top">
      <div class="header-brand-row">
        <a href="/" class="logo-link" title="Главная страница ГБПОУ РО «Сальский индустриальный техникум»">
          <img src="/assets/images/logo.png" alt="Логотип ГБПОУ РО «Сальский индустриальный техникум»" onerror="this.style.display='none'">
        </a>
        
        <div class="site-title">
          ГБПОУ РО<br>
          <small>«Сальский индустриальный техникум»</small>
        </div>
        
        <a href="/" class="gerb-link" title="Герб Ростовской области — официальный сайт техникума">
          <img src="/assets/images/gerb-red1.png" alt="Герб Ростовской области" onerror="this.style.display='none'">
        </a>
      </div>
    </div>
    
    <!-- НАВИГАЦИЯ (как на sit-salsk.ru) -->
    <div class="header-nav">
      <nav class="navbar navbar-expand-lg" aria-label="Основное меню">
        <div class="container-fluid px-0">
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" 
                  aria-controls="navbarMain" aria-expanded="false" aria-label="Меню навигации">
            <span class="navbar-toggler-icon"></span>
          </button>
          
          <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              {% for item in menu.main %}
                {% if item.key in ['home', 'svedenija', 'abiturientam', 'studentam', 'umr', 'vospitanie', 'bezopasnost'] %}
                  {% set isActiveSection = false %}
                  {% if item.key == 'home' %}
                    {% set isActiveSection = page.url == item.url %}
                  {% else %}
                    {% set isActiveSection = page.url | startsWith(item.url) %}
                  {% endif %}
                  {% set sectionIcon = '📁' %}
                  {% if item.key == 'home' %}
                    {% set sectionIcon = '🏠' %}
                  {% elif item.key == 'svedenija' %}
                    {% set sectionIcon = '📋' %}
                  {% elif item.key == 'abiturientam' %}
                    {% set sectionIcon = '🎓' %}
                  {% elif item.key == 'studentam' %}
                    {% set sectionIcon = '👨‍👩‍👧‍👦' %}
                  {% elif item.key == 'umr' %}
                    {% set sectionIcon = '📚' %}
                  {% elif item.key == 'vospitanie' %}
                    {% set sectionIcon = '🏋️' %}
                  {% elif item.key == 'bezopasnost' %}
                    {% set sectionIcon = '🛡️' %}
                  {% endif %}
                  {% if item.children %}
                  <li class="nav-item dropdown{% if isActiveSection %} active-section{% endif %}">
                    <a class="nav-link dropdown-toggle{% if isActiveSection %} active{% endif %}{% if item.key == 'abiturientam' %} nav-link--quick-pill{% endif %}" href="{{ item.url }}" role="button" data-bs-toggle="dropdown" 
                       aria-expanded="false" title="{{ item.title }}" {% if isActiveSection %}aria-current="page"{% endif %}>
                      <span class="nav-section-icon" aria-hidden="true">{{ sectionIcon }}</span>
                      <span>{{ item.title }}</span>
                    </a>
                    <ul class="dropdown-menu">
                      {% for child in item.children %}
                      {% set isActiveChild = page.url | startsWith(child.url) %}
                      <li><a class="dropdown-item{% if isActiveChild %} active{% endif %}" href="{{ child.url }}" title="{{ child.title }}" {% if isActiveChild %}aria-current="page"{% endif %}>{{ child.title }}</a></li>
                      {% endfor %}
                    </ul>
                  </li>
                  {% else %}
                  <li class="nav-item{% if isActiveSection %} active-section{% endif %}">
                    <a class="nav-link{% if isActiveSection %} active{% endif %}{% if item.key == 'abiturientam' %} nav-link--quick-pill{% endif %}" href="{{ item.url }}" title="{{ item.title }}" {% if isActiveSection %}aria-current="page"{% endif %}>
                      <span class="nav-section-icon" aria-hidden="true">{{ sectionIcon }}</span>
                      <span>{{ item.title }}</span>
                    </a>
                  </li>
                  {% endif %}
                {% endif %}
              {% endfor %}
              
            </ul>
          </div>
        </div>
      </nav>
    </div>
    
    <!-- ИНФОРМАЦИОННАЯ ПАНЕЛЬ: график, телефоны, ЭОС, иконки действий -->
    <!-- Десктопная версия (видна на md и выше) -->
    <div class="header-info-bar d-none d-md-block">
      <div class="d-flex flex-wrap align-items-center justify-content-between">
        <!-- Левая группа: график -->
        <div class="info-item">
          <i class="bi bi-clock" title="Режим работы"></i>
          <span><strong>Пн–Пт:</strong> 8:00–17:00 &nbsp;|&nbsp; <strong>Сб, Вс:</strong> выходной</span>
        </div>
        
        <!-- Центральная группа: корпуса и ЭОС -->
        <div class="d-flex gap-4 align-items-center">
          {% for corps in contacts.corps %}
          <div class="info-item">
            <i class="bi bi-building" title="{{ corps.name }}"></i>
            <span>{{ corps.name | replace(' (приёмная)', '') }}: <a href="tel:{{ corps.phone }}" title="Позвонить в {{ corps.name }}">{{ corps.phone_formatted }}</a> (приёмная)</span>
          </div>
          {% endfor %}
          
          <!-- Ссылка на ЭОС -->
          <a href="{{ contacts.eos_url }}" class="eos-link" target="_blank" rel="noopener" title="Электронная образовательная система ГБПОУ РО «СИТ»">
            <i class="bi bi-laptop"></i> ЭОС
          </a>
        </div>
        
        <!-- Правая группа: иконки (ВК, почта, поиск, доступность) -->
        <div class="header-actions">
          <a href="{{ social.vk }}" class="btn-icon" target="_blank" rel="noopener" title="Официальная группа ВКонтакте">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24" style="display:block;">
              <path d="M21.579 6.855c.17-.565 0-.98-.802-.98h-2.652c-.67 0-.979.357-1.146.752 0 0-1.34 3.283-3.237 5.414-.614.618-.893.814-1.228.814-.17 0-.42-.196-.42-.76V6.854c0-.671-.19-.98-.76-.98H9.389c-.42 0-.67.315-.67.615 0 .644.96.793 1.06 2.605v3.935c0 .864-.155 1.021-.492 1.021-.893 0-3.066-3.303-4.355-7.083C4.68 6.37 4.428 5.875 3.754 5.875H1.102c-.76 0-.913.357-.913.752 0 .704.893 4.197 4.155 8.817 2.175 3.144 5.239 4.848 8.026 4.848 1.674 0 1.88-.38 1.88-1.035v-2.385c0-.76.16-.912.694-.912.393 0 1.067.198 2.641 1.727 1.798 1.81 2.094 2.62 3.102 2.62h2.652c.76 0 1.14-.38.92-1.134-.237-.744-1.092-1.82-2.226-3.101-.614-.73-1.535-1.517-1.814-1.91-.393-.508-.28-.733 0-1.185 0 0 3.21-4.55 3.546-6.095z"/>
            </svg>
          </a>
          <a href="mailto:{{ contacts.email }}" class="btn-icon" title="Написать на почту администрации">
            <i class="bi bi-envelope-fill"></i>
          </a>
          <button class="btn-icon" data-bs-toggle="modal" data-bs-target="#searchModal" title="Поиск по сайту">
            <i class="bi bi-search"></i>
          </button>
          <button class="btn-icon a11y-toggle-btn" id="a11yToggleHeader" title="Версия для слабовидящих">
            <i class="bi bi-eye"></i>
          </button>
        </div>
      </div>
    </div>
    
    <!-- Упрощённая версия для мобильных (видна на <md) -->
    <div class="header-info-bar d-md-none">
      <div class="d-flex flex-wrap align-items-center justify-content-between">
        <div class="d-flex flex-wrap gap-2">
          <span><i class="bi bi-clock" title="Режим работы"></i> Пн–Пт 8–17, Сб-Вс вых.</span>
          <span><i class="bi bi-telephone" title="Телефоны"></i> К1: 5-05-71, К2: 5-60-41</span>
          <a href="{{ contacts.eos_url }}" class="eos-link header-mobile-pill header-mobile-pill--eos" target="_blank" rel="noopener" title="Электронная образовательная система">
            <span aria-hidden="true">💻</span> ЭОС
          </a>
        </div>
        <div class="header-actions">
          <a href="{{ social.vk }}" class="btn-icon" target="_blank" rel="noopener" title="ВКонтакте">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24" style="display:block;">
              <path d="M21.579 6.855c.17-.565 0-.98-.802-.98h-2.652c-.67 0-.979.357-1.146.752 0 0-1.34 3.283-3.237 5.414-.614.618-.893.814-1.228.814-.17 0-.42-.196-.42-.76V6.854c0-.671-.19-.98-.76-.98H9.389c-.42 0-.67.315-.67.615 0 .644.96.793 1.06 2.605v3.935c0 .864-.155 1.021-.492 1.021-.893 0-3.066-3.303-4.355-7.083C4.68 6.37 4.428 5.875 3.754 5.875H1.102c-.76 0-.913.357-.913.752 0 .704.893 4.197 4.155 8.817 2.175 3.144 5.239 4.848 8.026 4.848 1.674 0 1.88-.38 1.88-1.035v-2.385c0-.76.16-.912.694-.912.393 0 1.067.198 2.641 1.727 1.798 1.81 2.094 2.62 3.102 2.62h2.652c.76 0 1.14-.38.92-1.134-.237-.744-1.092-1.82-2.226-3.101-.614-.73-1.535-1.517-1.814-1.91-.393-.508-.28-.733 0-1.185 0 0 3.21-4.55 3.546-6.095z"/>
            </svg>
          </a>
          <a href="mailto:{{ contacts.email }}" class="btn-icon" title="Почта">
            <i class="bi bi-envelope-fill"></i>
          </a>
          <button class="btn-icon" data-bs-toggle="modal" data-bs-target="#searchModal" title="Поиск">
            <i class="bi bi-search"></i>
          </button>
          <button class="btn-icon a11y-toggle-btn" id="a11yToggleMobile" title="Версия для слабовидящих">
            <i class="bi bi-eye"></i>
          </button>
        </div>
      </div>
    </div>
    
    <!-- ПАНЕЛЬ С РУБРИКАТОРОМ (2/3) И ССЫЛКОЙ "Контакты" (1/3) -->
    <div class="header-actions-panel">
      <div class="row align-items-center g-3">
        <!-- Рубрикатор (2/3) -->
        <div class="col-md-8">
          <select class="form-select rubric-select" id="rubricSelect" aria-label="Выберите рубрику" title="Навигация по разделам сайта">
            <option selected disabled>Выберите рубрику</option>
            {% for rubric in rubrics.main_rubrics %}
              {% if rubric.level == 0 %}
            <option class="level-0" value="/{{ rubric.slug }}/">{{ rubric.code }}. {{ rubric.title }}</option>
                {% if rubric.children %}
                  {% for child in rubric.children %}
            <option class="level-1" value="/{{ rubric.slug }}/{{ child.slug }}/">&nbsp;&nbsp;&nbsp;{{ rubric.code }}.{{ loop.parent.loop.index }}.{{ loop.index }} {{ child.title }}</option>
                    {% if child.children %}
                      {% for subchild in child.children %}
            <option class="level-2" value="/{{ rubric.slug }}/{{ child.slug }}/{{ subchild.slug }}/">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ rubric.code }}.{{ loop.parent.parent.loop.index }}.{{ loop.parent.loop.index }}.{{ loop.index }} {{ subchild.title }}</option>
                      {% endfor %}
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endif %}
            {% endfor %}
          </select>
        </div>
        
        <!-- Правая часть (1/3): ссылка "Контакты техникума" -->
        <div class="col-md-4 svedeniya-block">
          <a class="nav-link" href="/contacts/" title="Контакты техникума">Контакты</a>
        </div>
      </div>
    </div>
    
  </div>
</header>

<!-- МОДАЛЬНОЕ ОКНО ПОИСКА (Bootstrap Modal) -->
<div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="searchModalLabel">Поиск по сайту</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
      </div>
      <div class="modal-body">
        {# TODO: подключить Lunr.js поиск #}
        <form role="search" action="/search/" method="get">
          <div class="input-group">
            <input type="search" class="form-control" name="q" placeholder="Введите запрос..." aria-label="Поисковый запрос">
            <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Найти</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
