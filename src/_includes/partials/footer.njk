<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">

      <div class="footer-col footer-brand">
        <div class="footer-logo-text">ГБПОУ РО<br><span>«Сальский индустриальный техникум»</span></div>
        <p class="footer-tagline">{{ site.description }}</p>
        <div class="footer-social">
          <a href="{{ social.vk }}" target="_blank" rel="noopener" class="footer-social-link" title="ВКонтакте">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M21.579 6.855c.17-.565 0-.98-.802-.98h-2.652c-.67 0-.979.357-1.146.752 0 0-1.34 3.283-3.237 5.414-.614.618-.893.814-1.228.814-.17 0-.42-.196-.42-.76V6.854c0-.671-.19-.98-.76-.98H9.389c-.42 0-.67.315-.67.615 0 .644.96.793 1.06 2.605v3.935c0 .864-.155 1.021-.492 1.021-.893 0-3.066-3.303-4.355-7.083C4.68 6.37 4.428 5.875 3.754 5.875H1.102c-.76 0-.913.357-.913.752 0 .704.893 4.197 4.155 8.817 2.175 3.144 5.239 4.848 8.026 4.848 1.674 0 1.88-.38 1.88-1.035v-2.385c0-.76.16-.912.694-.912.393 0 1.067.198 2.641 1.727 1.798 1.81 2.094 2.62 3.102 2.62h2.652c.76 0 1.14-.38.92-1.134-.237-.744-1.092-1.82-2.226-3.101-.614-.73-1.535-1.517-1.814-1.91-.393-.508-.28-.733 0-1.185 0 0 3.21-4.55 3.546-6.095z"/></svg>
          </a>
          <a href="{{ social.rutube }}" target="_blank" rel="noopener" class="footer-social-link" title="RuTube">
            <i class="bi bi-play-circle-fill"></i>
          </a>
          <a href="mailto:{{ contacts.email }}" class="footer-social-link" title="Электронная почта">
            <i class="bi bi-envelope-fill"></i>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Разделы сайта</h4>
        <ul class="footer-links">
          <li><a href="/">Главная</a></li>
          <li><a href="/svedenija/">Сведения об организации</a></li>
          <li><a href="/abiturientam/">Абитуриентам</a></li>
          <li><a href="/studentam-i-roditeljam/">Студентам и родителям</a></li>
          <li><a href="/vospitanie/">Воспитание</a></li>
          <li><a href="/bezopasnost/">Безопасность</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Контакты</h4>
        <ul class="footer-contacts">
          <li>
            <i class="bi bi-geo-alt-fill"></i>
            <span>{{ contacts.address }}</span>
          </li>
          {% for corps in contacts.corps %}
          <li>
            <i class="bi bi-telephone-fill"></i>
            <span>{{ corps.name | replace(' (приёмная)', '') }}: <a href="tel:{{ corps.phone }}">{{ corps.phone_formatted }}</a></span>
          </li>
          {% endfor %}
          <li>
            <i class="bi bi-envelope-fill"></i>
            <a href="mailto:{{ contacts.email }}">{{ contacts.email }}</a>
          </li>
          <li>
            <i class="bi bi-clock-fill"></i>
            <span>{{ contacts.working_hours }}</span>
          </li>
        </ul>
      </div>

    </div>

    <div class="footer-bottom">
      <p>&copy; 2026 ГБПОУ РО «Сальский индустриальный техникум». Все права защищены.</p>
      <a href="{{ contacts.eos_url }}" target="_blank" rel="noopener" class="footer-eos-link">
        <i class="bi bi-laptop"></i> ЭОС — Электронная образовательная система
      </a>
    </div>
  </div>
</footer>
