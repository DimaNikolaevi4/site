{# Хлебные крошки (динамические) #}
<nav class="breadcrumbs" aria-label="Хлебные крошки">
  <ol class="breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
    {% if breadcrumbs %}
      {% for crumb in breadcrumbs %}
        <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          {% if loop.last %}
            <span itemprop="name">{{ crumb.text }}</span>
            <meta itemprop="position" content="{{ loop.index }}" />
          {% else %}
            <a href="{{ crumb.url }}" itemprop="item">
              <span itemprop="name">{{ crumb.text }}</span>
            </a>
            <meta itemprop="position" content="{{ loop.index }}" />
          {% endif %}
        </li>
      {% endfor %}
    {% else %}
      {# Автоматические хлебные крошки на основе пути #}
      <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" itemprop="item">
          <span itemprop="name">Главная</span>
        </a>
        <meta itemprop="position" content="1" />
      </li>
      
      {% set parts = page.url.split('/') %}
      {% for part in parts %}
        {% if part and part != '' %}
          <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            {% if loop.last %}
              <span itemprop="name">{{ part | capitalize }}</span>
              <meta itemprop="position" content="{{ loop.index + 1 }}" />
            {% else %}
              {% set href = '/' + parts.slice(1, loop.index + 1).join('/') %}
              <a href="{{ href }}/" itemprop="item">
                <span itemprop="name">{{ part | capitalize }}</span>
              </a>
              <meta itemprop="position" content="{{ loop.index + 1 }}" />
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    {% endif %}
  </ol>
</nav>
