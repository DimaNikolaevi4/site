{# Модальное окно поиска (Секция 1) #}
<div class="search-modal" id="searchModal" role="dialog" aria-labelledby="searchModalTitle" aria-modal="true" hidden>
  <div class="search-modal-overlay" data-search-close></div>
  
  <div class="search-modal-content">
    <header class="search-modal-header">
      <h2 id="searchModalTitle" class="search-modal-title">Поиск по сайту</h2>
      <button 
        type="button" 
        class="search-modal-close" 
        data-search-close
        aria-label="Закрыть поиск"
      >
        ×
      </button>
    </header>
    
    <form class="search-modal-form" data-search-form>
      <div class="search-input-wrapper">
        <input 
          type="search" 
          class="search-input" 
          placeholder="Введите запрос..." 
          data-search-input
          aria-label="Поисковый запрос"
          autocomplete="off"
        >
        <button type="submit" class="search-submit" aria-label="Найти">
          <span class="visually-hidden">Найти</span>
        </button>
      </div>
    </form>
    
    <div class="search-results" data-search-results aria-live="polite">
      {# Результаты поиска будут здесь #}
    </div>
    
    <div class="search-loading" data-search-loading hidden>
      <span class="spinner"></span>
      <span>Поиск...</span>
    </div>
    
    <footer class="search-modal-footer">
      <p class="search-hint">
        Введите минимум 2 символа для поиска. Поиск осуществляется по заголовкам и содержанию материалов.
      </p>
    </footer>
  </div>
</div>
