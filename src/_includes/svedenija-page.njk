---
layout: base.njk
---
<div class="svedenija-container">
  <aside class="svedenija-sidebar" aria-label="Разделы сведений">
    <nav>
      <ul>
        {% for item in svedenijaMenu %}
        <li>
          <a href="{{ item.url }}" 
             {% if page.url == item.url %}class="active" aria-current="page"{% endif %}>
            {{ item.title }}
          </a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </aside>
  
  <main class="svedenija-content" role="main">
    <h1>{{ title }}</h1>
    {{ content | safe }}
  </main>
</div>
