{#
  ШАБЛОН ТИП C — layouts/post.njk
  Материалы: новости, документы, события, страницы подразделов

  Секция 1: Header          — глобальная, в base.njk
  Секция 2: Hero + Контекст — hero-баннер (опц.), хлебные крошки, заголовок, мета
  Секция 3+7: Контент + Сайдбар — сетка 70/30 (контент | сайдбар с баннерами)
     Контент: обложка, текст материала, вложения, теги
     Сайдбар: components/sidebar.njk (30% левая колонка, единые баннеры)
  Секция 4: «Читайте также» — связанные материалы (опц.)
  Секция 6: Нижняя навигация — возврат к ленте, пред/след материал
  Секция 8: Footer           — глобальная, в base.njk

  Управление через frontmatter:
    hero:           { image, title, subtitle, alt, cta } — Hero-баннер
    coverImage:     URL строка — обложка внутри контентной зоны
    coverAlt:       строка — alt текста обложки
    date:           дата публикации
    author:         строка — автор
    category:       slug раздела (для хлебных крошек и мета)
    categoryTitle:  строка — человеческое название категории
    section:        slug раздела (альтернатива category)
    sectionTitle:   строка — человеческое название раздела
    readingTime:    число (минут) — время чтения (автоматом или вручную)
    attachments:    массив { url, name, size } — вложения
    tags:           массив строк — теги
    showSidebar:    true/false (по умолчанию true)
    sidebarBanners: массив — переопределить стандартные баннеры
    relatedPages:   массив { url, title, image, excerpt, date }
    parentSection:  { url, title } — явная ссылка «назад»
    prevPost:       { url, title }
    nextPost:       { url, title }
#}
{% extends "layouts/base.njk" %}

{% block content %}
{% set _showSidebar = showSidebar if showSidebar is defined else true %}

<article class="post-layout" itemscope itemtype="https://schema.org/Article">

  {# ═══════════════════════════════════════════════
     СЕКЦИЯ 2: Hero (опц.) + Контекст + Мета
  ═══════════════════════════════════════════════ #}

  {# Hero-баннер — если задан hero.image #}
  {% include "components/hero.njk" %}

  {# Контекстная полоса: хлебные крошки + заголовок + мета #}
  <section class="section-context section-context--post" aria-label="Информация о материале">
    <div class="container">

      {# Хлебные крошки: Главная → Раздел → (Подраздел) → Заголовок #}
      {% include "components/breadcrumbs.njk" %}

      <header class="post-header">

        {# Метка категории над заголовком #}
        {% if category or section %}
        <div class="post-header__rubric">
          {% if category %}
          <a href="/{{ category | slugify }}/" class="post-rubric-badge">
            <i class="bi bi-folder2-open" aria-hidden="true"></i>
            {{ categoryTitle or category }}
          </a>
          {% elif section %}
          <a href="/{{ section | slugify }}/" class="post-rubric-badge">
            <i class="bi bi-folder2-open" aria-hidden="true"></i>
            {{ sectionTitle or section }}
          </a>
          {% endif %}
        </div>
        {% endif %}

        {# Заголовок #}
        {% if showHero == false %}
        <h1 class="post-title" itemprop="headline">{{ title }}</h1>
        {% endif %}

        {# Мета-строка: дата, автор, время чтения #}
        <div class="post-meta">
          {% if date %}
          <time class="post-meta__item post-date"
                datetime="{{ date | dateToISO }}"
                itemprop="datePublished">
            <i class="bi bi-calendar3" aria-hidden="true"></i>
            <span class="visually-hidden">Дата публикации:</span>
            {{ date | dateRu }}
          </time>
          {% endif %}

          {% if author %}
          <span class="post-meta__item post-author" itemprop="author" itemscope itemtype="https://schema.org/Person">
            <i class="bi bi-person" aria-hidden="true"></i>
            <span class="visually-hidden">Автор:</span>
            <span itemprop="name">{{ author }}</span>
          </span>
          {% endif %}

          {% if readingTime %}
          <span class="post-meta__item post-reading-time">
            <i class="bi bi-clock" aria-hidden="true"></i>
            {{ readingTime }} мин
          </span>
          {% endif %}
        </div>

      </header>
    </div>
  </section>

  {# ═══════════════════════════════════════════════
     СЕКЦИИ 3 + 7: Контент (70%) + Сайдбар (30%)
     Сайдбар — слева, контент — справа
  ═══════════════════════════════════════════════ #}
  <section class="section-main">
    <div class="container">
      <div class="content-sidebar-grid{% if not _showSidebar %} content-sidebar-grid--full{% endif %}">

        {# ── Секция 7: Сайдбар (30% левая колонка) ── #}
        {% if _showSidebar %}
        <div class="sidebar-col">
          {% include "components/sidebar.njk" %}
        </div>
        {% endif %}

        {# ── Секция 3: Контент материала ── #}
        <div class="content-col">

          {# Обложка материала (если есть и нет полноэкранного hero) #}
          {% if coverImage and showHero == false %}
          <figure class="post-cover">
            <img src="{{ coverImage }}"
                 alt="{{ coverAlt or title }}"
                 loading="eager"
                 class="post-cover__img img-fluid rounded"
                 itemprop="image">
          </figure>
          {% endif %}

          {# Основной текст #}
          <div class="post-content" itemprop="articleBody">
            {{ content | safe }}
          </div>

          {# Вложения: PDF, DOC, XLS и другие файлы #}
          {% if attachments and attachments.length > 0 %}
          <section class="post-attachments" aria-label="Вложения к материалу">
            <h2 class="attachments-title">
              <i class="bi bi-paperclip" aria-hidden="true"></i> Вложения
            </h2>
            <ul class="attachments-list" role="list">
              {% for attachment in attachments %}
              <li class="attachment-item" role="listitem">
                <a href="{{ attachment.url }}"
                   class="attachment-link"
                   download
                   {% if attachment.size %}title="Скачать ({{ attachment.size }})"{% endif %}>

                  {# Иконка по типу файла #}
                  {% set _ext = attachment.url | lower %}
                  {% if '.pdf' in _ext %}
                    <i class="bi bi-file-earmark-pdf attachment-icon attachment-icon--pdf" aria-hidden="true"></i>
                  {% elif '.doc' in _ext %}
                    <i class="bi bi-file-earmark-word attachment-icon attachment-icon--doc" aria-hidden="true"></i>
                  {% elif '.xls' in _ext %}
                    <i class="bi bi-file-earmark-excel attachment-icon attachment-icon--xls" aria-hidden="true"></i>
                  {% elif '.ppt' in _ext %}
                    <i class="bi bi-file-earmark-ppt attachment-icon attachment-icon--ppt" aria-hidden="true"></i>
                  {% elif '.zip' in _ext or '.rar' in _ext %}
                    <i class="bi bi-file-earmark-zip attachment-icon" aria-hidden="true"></i>
                  {% elif '.jpg' in _ext or '.png' in _ext or '.gif' in _ext or '.webp' in _ext %}
                    <i class="bi bi-file-earmark-image attachment-icon" aria-hidden="true"></i>
                  {% else %}
                    <i class="bi bi-file-earmark attachment-icon" aria-hidden="true"></i>
                  {% endif %}

                  <span class="attachment-name">{{ attachment.name }}</span>
                  {% if attachment.size %}
                  <span class="attachment-size">({{ attachment.size }})</span>
                  {% endif %}
                </a>
              </li>
              {% endfor %}
            </ul>
          </section>
          {% endif %}

          {# Теги #}
          {% if tags and tags.length > 0 %}
          <footer class="post-footer">
            <div class="post-tags">
              <span class="tags-label">
                <i class="bi bi-tags" aria-hidden="true"></i> Теги:
              </span>
              {% for tag in tags %}
                {% if tag != 'nav' and tag != 'all' and tag != 'post' and tag != 'news' %}
                <a href="/tags/{{ tag | slugify }}/" class="tag" itemprop="keywords">{{ tag }}</a>
                {% endif %}
              {% endfor %}
            </div>
          </footer>
          {% endif %}

          {# Кнопка поделиться (нативный Web Share API) #}
          <div class="post-share" aria-label="Поделиться материалом">
            <button class="post-share__btn btn btn-outline-secondary btn-sm"
                    onclick="if(navigator.share){navigator.share({title:document.title,url:location.href})}else{navigator.clipboard.writeText(location.href).then(()=>alert('Ссылка скопирована'))}"
                    type="button">
              <i class="bi bi-share" aria-hidden="true"></i> Поделиться
            </button>
          </div>

        </div>{# /.content-col #}

      </div>{# /.content-sidebar-grid #}
    </div>
  </section>

  {# ═══════════════════════════════════════════════
     СЕКЦИЯ 4: «Читайте также» / Связанные материалы
  ═══════════════════════════════════════════════ #}
  {% if relatedPages and relatedPages.length > 0 %}
  <section class="section-related" aria-label="Читайте также">
    <div class="container">
      <h2 class="section-related__title">
        <i class="bi bi-journals" aria-hidden="true"></i> Читайте также
      </h2>
      <div class="related-grid">
        {% for item in relatedPages %}
        <article class="related-card">
          {% if item.image %}
          <div class="related-card__img">
            <a href="{{ item.url }}">
              <img src="{{ item.image }}" alt="{{ item.title }}" loading="lazy">
            </a>
          </div>
          {% endif %}
          <div class="related-card__body">
            {% if item.date %}
            <time class="related-card__date">{{ item.date | dateRu }}</time>
            {% endif %}
            <h3 class="related-card__title">
              <a href="{{ item.url }}">{{ item.title }}</a>
            </h3>
            {% if item.excerpt %}
            <p class="related-card__excerpt">{{ item.excerpt }}</p>
            {% endif %}
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {# ═══════════════════════════════════════════════
     СЕКЦИЯ 6: Нижняя навигация
     Возврат к ленте / пред. / след. материал
  ═══════════════════════════════════════════════ #}
  <nav class="section-backnav" aria-label="Навигация по материалам">
    <div class="container">

      {# Ссылка «назад в раздел» #}
      {% if parentSection %}
      <a href="{{ parentSection.url }}" class="backnav-link backnav-link--parent">
        <i class="bi bi-arrow-left-circle" aria-hidden="true"></i>
        {{ parentSection.title }}
      </a>
      {% elif category %}
      <a href="/{{ category | slugify }}/" class="backnav-link backnav-link--parent">
        <i class="bi bi-arrow-left-circle" aria-hidden="true"></i>
        {{ categoryTitle or category }}
      </a>
      {% elif section %}
      <a href="/{{ section | slugify }}/" class="backnav-link backnav-link--parent">
        <i class="bi bi-arrow-left-circle" aria-hidden="true"></i>
        {{ sectionTitle or section }}
      </a>
      {% else %}
      <a href="/" class="backnav-link backnav-link--parent">
        <i class="bi bi-house" aria-hidden="true"></i>
        Главная
      </a>
      {% endif %}

      {# Пред/след материал #}
      <div class="backnav-prevnext">
        {% if prevPost %}
        <a href="{{ prevPost.url }}"
           class="backnav-link backnav-link--prev"
           title="{{ prevPost.title }}">
          <i class="bi bi-chevron-left" aria-hidden="true"></i> Предыдущий
        </a>
        {% endif %}
        {% if nextPost %}
        <a href="{{ nextPost.url }}"
           class="backnav-link backnav-link--next"
           title="{{ nextPost.title }}">
          Следующий <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </a>
        {% endif %}
      </div>

    </div>
  </nav>

</article>
{% endblock %}
