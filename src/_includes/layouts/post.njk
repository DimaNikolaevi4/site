{# Макет для материалов (новости, документы) #}
{% extends "layouts/base.njk" %}

{% block content %}
<div class="page-hero">
  <div class="container">
    <nav class="page-hero__breadcrumbs" aria-label="Хлебные крошки">
      <ol>
        <li><a href="/">Главная</a></li>
        {% if category %}
        <li><a href="/{{ category | lower }}/">{{ category }}</a></li>
        {% endif %}
        <li>{{ title }}</li>
      </ol>
    </nav>
    <h1 class="page-hero__title">{{ title }}</h1>
    {% if date or author %}
    <div class="page-hero__meta">
      {% if date %}
      <time datetime="{{ date | dateToISO }}">{{ date | dateRu }}</time>
      {% endif %}
      {% if author %}
      <span>{{ author }}</span>
      {% endif %}
    </div>
    {% endif %}
  </div>
</div>

<section class="section">
  <div class="container">
    <article class="post-content" itemprop="articleBody">
      {{ content | safe }}
    </article>

    {% if attachments %}
    <section class="post-attachments" aria-label="Вложения">
      <h2>Вложения</h2>
      <ul>
        {% for attachment in attachments %}
        <li>
          <a href="{{ attachment.url }}" download>
            {{ attachment.name }}{% if attachment.size %} ({{ attachment.size }}){% endif %}
          </a>
        </li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}
  </div>
</section>
{% endblock %}
