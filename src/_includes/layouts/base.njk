<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="/assets/mentor/vendor/bootstrap/css/bootstrap.min.css">
  <link rel="stylesheet" href="/assets/mentor/vendor/bootstrap-icons/bootstrap-icons.css">
  <link rel="stylesheet" href="/assets/mentor/vendor/aos/aos.css">
  <link rel="stylesheet" href="/assets/mentor/vendor/glightbox/css/glightbox.min.css">
  <link rel="stylesheet" href="/assets/mentor/vendor/swiper/swiper-bundle.min.css">
  <link rel="stylesheet" href="/assets/mentor/css/main.css">
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body class="page page--{{ layout or 'default' }}">
  <!-- Шапка -->
