{#
  ШАБЛОН ТИП B — layouts/page.njk
  Все 8 секций для страниц разделов (любой уровень)

  Канон секций (тот же на всём сайте):
    Секция 1: Header              — components/header.njk        (в base.njk)
    Секция 2: Hero                — components/hero.njk          (в base.njk)
    Секция 3: Хлебные крошки      — components/breadcrumbs.njk
    Секция 4: About               — components/about.njk         (опц., aboutMode)
    Секция 5: Сайдбар             — components/sidebar.njk       (30% слева, sticky)
    Секция 6: Материалы / News    — components/news.njk          (опц., newsMode)
    Секция 7: Популярное          — components/popular.njk       (опц., showPopular)
    Секция 8: Footer              — components/footer.njk        (в base.njk)
  + Нижняя навигация (возврат к разделу) — между Секцией 7 и Секцией 8.

  Управление секциями через frontmatter:
    hero:              { image, title, subtitle, alt, cta } — включает Hero-баннер
    rubricTitle:       строка — название рубрики под чертой в Hero
    showSidebar:       true/false (по умолчанию true) — 30% левая колонка с баннерами
    sidebarBanners:    массив — переопределить стандартные баннеры сайдбара
    showAbout:         true/false (по умолчанию false) — секция 4
    aboutMode:         'director' | 'section' | 'stub'
    aboutTitle:        строка (для aboutMode='section')
    aboutText:         HTML (для aboutMode='section')
    aboutImage:        URL (для aboutMode='section')
    aboutUrl:          URL (для aboutMode='section')
    showNews:          true/false (по умолчанию false) — секция 5
    newsMode:          'latest' | 'subrubrics'
    newsTitle:         строка
    newsCollection:    имя коллекции (для newsMode='subrubrics')
    newsCount:         число (для newsMode='latest', по умолчанию 3)
    showPopular:       true/false (по умолчанию false) — секция 6
    popularTitle:      строка
    popularLinks:      массив { title, subtitle, description, url, icon }
    additionalBlocks:  HTML-строка — доп. блоки после контента
    parentSection:     { url, title } — для нижней навигации
    prevPage:          { url, title }
    nextPage:          { url, title }
    relatedPages:      массив { url, title, image, excerpt, date }
#}
{% extends "layouts/base.njk" %}

{% block content %}
{% set _showSidebar = showSidebar if showSidebar is defined else true %}

<div class="page-layout page-type-b">

  {# ═══════════════════════════════════════════════
     СЕКЦИЯ 2: Hero — единый, рендерится в base.njk
     (см. components/hero.njk; управляется frontmatter:
      showHero / rubricTitle / hero.*)
  ═══════════════════════════════════════════════ #}

  {# Контекстная полоса: хлебные крошки + заголовок + описание + баннер раздела #}
  <section class="section-context" aria-label="Контекст страницы">
    <div class="container">

      {% include "components/breadcrumbs.njk" %}

      <div class="context-header">
        {% if showHero == false %}
        <h1 class="page-title">{{ title }}</h1>
        {% endif %}
        {% if description %}
        <p class="page-description lead text-muted">{{ description }}</p>
        {% endif %}
      </div>

      {# Баннер раздела (если нет full-hero) #}
      {% if showHero == false and sectionContext and sectionContext.banner %}
      <div class="page-banner mt-3">
        <img src="{{ sectionContext.banner }}"
             alt="{{ title }}"
             loading="lazy"
             class="img-fluid rounded">
      </div>
      {% endif %}

    </div>
  </section>

  {# ═══════════════════════════════════════════════
     СЕКЦИИ 3 + 7: Контент (70%) + Сайдбар (30%)
     Сайдбар — слева, контент — справа
  ═══════════════════════════════════════════════ #}
  <section class="section-main">
    <div class="container">
      <div class="content-sidebar-grid{% if not _showSidebar %} content-sidebar-grid--full{% endif %}">

        {# ── Секция 5: Сайдбар (30% левая колонка) ── #}
        {% if _showSidebar %}
        <div class="sidebar-col">
          {% include "components/sidebar.njk" %}
        </div>
        {% endif %}

        {# ── Основной контент страницы ── #}
        <div class="content-col">
          <article class="page-content" itemprop="mainContentOfPage">
            {{ content | safe }}
          </article>

          {# Дополнительные блоки (документы, уведомления, произвольный HTML) #}
          {% if additionalBlocks %}
          <div class="section-extra mt-4">
            <div class="extra-inner">
              {{ additionalBlocks | safe }}
            </div>
          </div>
          {% endif %}
        </div>

      </div>
    </div>
  </section>

  {# ═══════════════════════════════════════════════
     СЕКЦИЯ 4: About (заглушка или слово директора)
     Показывается только если showAbout: true
  ═══════════════════════════════════════════════ #}
  {% if showAbout %}
  {% include "components/about.njk" %}
  {% endif %}

  {# ═══════════════════════════════════════════════
     СЕКЦИЯ 5: Материалы (подрубрики или последние новости)
     Показывается только если showNews: true
  ═══════════════════════════════════════════════ #}
  {% if showNews %}
  {% include "components/news.njk" %}
  {% endif %}

  {# ═══════════════════════════════════════════════
     СЕКЦИЯ 6: Популярные разделы
     Показывается только если showPopular: true
  ═══════════════════════════════════════════════ #}
  {% if showPopular %}
  {% include "components/popular.njk" %}
  {% endif %}

  {# ═══════════════════════════════════════════════
     Связанные материалы / «Читайте также»
     Разметка и логика автоподбора — в components/_partials/related.njk
  ═══════════════════════════════════════════════ #}
  {% include "components/_partials/related.njk" %}

  {# ═══════════════════════════════════════════════
     Нижняя навигация (возврат к разделу, пред/след)
  ═══════════════════════════════════════════════ #}
  {% if parentSection or prevPage or nextPage or category or section %}
  <nav class="section-backnav" aria-label="Навигация по разделу">
    <div class="container">

      {% set _bnLabels = sectionLabels or { byUrl: {}, bySlug: {} } %}
      {% set _bnKey = category or section %}
      {% set _bnSlug = _bnKey | slugify if _bnKey else "" %}
      {% set _bnUrl = "/" + _bnSlug + "/" if _bnSlug else "" %}
      {% set _bnLabel = categoryTitle or sectionTitle or _bnLabels.byUrl[_bnUrl] or _bnLabels.bySlug[_bnSlug] or _bnLabels.bySlug[_bnKey] or _bnKey %}

      {% if parentSection %}
      <a href="{{ parentSection.url }}" class="backnav-link backnav-link--parent">
        <i class="bi bi-arrow-left-circle" aria-hidden="true"></i>
        {{ parentSection.title }}
      </a>
      {% elif _bnKey %}
      <a href="{{ _bnUrl }}" class="backnav-link backnav-link--parent">
        <i class="bi bi-arrow-left-circle" aria-hidden="true"></i>
        {{ _bnLabel }}
      </a>
      {% endif %}

      <div class="backnav-prevnext">
        {% if prevPage %}
        <a href="{{ prevPage.url }}" class="backnav-link backnav-link--prev" title="{{ prevPage.title }}">
          <i class="bi bi-chevron-left" aria-hidden="true"></i> Предыдущая
        </a>
        {% endif %}
        {% if nextPage %}
        <a href="{{ nextPage.url }}" class="backnav-link backnav-link--next" title="{{ nextPage.title }}">
          Следующая <i class="bi bi-chevron-right" aria-hidden="true"></i>
        </a>
        {% endif %}
      </div>

    </div>
  </nav>
  {% endif %}

</div>
{% endblock %}
