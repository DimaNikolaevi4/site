{# Макет для статических страниц #}
{% extends "layouts/base.njk" %}

{% block content %}
<div class="page-hero">
  <div class="container">
    <nav class="page-hero__breadcrumbs" aria-label="Хлебные крошки">
      <ol>
        <li><a href="/">Главная</a></li>
        {% if eleventyNavigation and eleventyNavigation.parent %}
        <li><a href="/{{ eleventyNavigation.parent | lower }}/">{{ eleventyNavigation.parent }}</a></li>
        {% endif %}
        <li>{{ title }}</li>
      </ol>
    </nav>
    <h1 class="page-hero__title">{{ title }}</h1>
  </div>
</div>

<section class="section">
  <div class="container">
    <article class="page-content">
      {{ content | safe }}
    </article>
  </div>
</section>
{% endblock %}
