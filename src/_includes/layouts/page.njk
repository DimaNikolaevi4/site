{# Макет для статических страниц #}
{% extends "layouts/base.njk" %}

{% block content %}
<div class="page-layout">
  {# Секция 2: Контекстная секция (хлебные крошки, заголовок) #}
  {% if sectionContext or title %}
  <section class="section-context" aria-label="Контекст страницы">
    <div class="container">
      {% include "partials/breadcrumbs.njk" %}
      <h1 class="page-title">{{ title }}</h1>
      
      {% if sectionContext.banner %}
      <div class="page-banner">
        <img src="{{ sectionContext.banner }}" alt="" role="presentation">
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}
  
  {# Секция 3: Основной контент #}
  <section class="section-main">
    <div class="container">
      <div class="content-wrapper{% if sidebar and sidebar.show %} with-sidebar{% endif %}">
        <article class="page-content" itemprop="mainContentOfPage">
          {{ content | safe }}
        </article>
        
        {# Секция 4: Дополнительные блоки #}
        {% if additionalBlocks %}
        <section class="section-extra" aria-label="Дополнительные материалы">
          {{ additionalBlocks | safe }}
        </section>
        {% endif %}
      </div>
      
      {# Секция 5: Сайдбар #}
      {% if sidebar and sidebar.show %}
      {% include "partials/sidebar.njk" %}
      {% endif %}
    </div>
  </section>
</div>
{% endblock %}
