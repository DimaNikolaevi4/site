{#
  Самостоятельный компонент hero-блока V2.
  Управляется front matter страницы:
    showHero      — false, чтобы выключить блок;
    hero.image    — фон (на главной по умолчанию выбирается из серии);
    hero.title    — подпись рубрики;
    hero.subtitle — необязательный подзаголовок;
    hero.alt      — описание фонового изображения;
    hero.cta      — необязательная кнопка { url, label };
    rubricTitle   — приоритетная подпись рубрики;
    title         — запасной текст рубрики;
    hideRubric    — режим главной страницы без подписи рубрики.
#}

{% if showHero != false %}

{% set _heroImages = [
  "/assets/images/hero/hero-students-01.jpg",
  "/assets/images/hero/hero-students-02.jpg",
  "/assets/images/hero/hero-students-03.jpg",
  "/assets/images/hero/hero-students-04.jpg",
  "/assets/images/hero/hero-students-05.jpg",
  "/assets/images/hero/hero-students-06.jpg",
  "/assets/images/hero/hero-students-07.jpg",
  "/assets/images/hero/hero-students-08.jpg"
] %}
{% set _hasCustomHeroImage = hero and hero.image %}
{% set _heroImage = (hero.image if hero and hero.image else null) or _heroImages[0] %}
{% set _heroAlt = (hero.alt if hero and hero.alt else null) or title or "Сальский индустриальный техникум" %}
{% set _heroRubric = rubricTitle or (hero.title if hero else null) or title %}

<section class="site-hero section-hero page-hero page-hero--banner component-hero" data-component="hero" aria-label="Баннер раздела">
  <div
    id="page-hero-bg"
    class="site-hero__background page-hero__bg"
    style="background-image: url('{{ _heroImage }}');"
    role="img"
    aria-label="{{ _heroAlt }}"
  ></div>

  {% if hideRubric and not _hasCustomHeroImage %}
  <script>
    (function () {
      var background = document.getElementById('page-hero-bg');
      var images = {{ _heroImages | dump | safe }};
      if (!background || !images.length) return;

      var storageKey = 'sit-hero-image';
      var selected = null;
      try {
        selected = sessionStorage.getItem(storageKey);
      } catch (error) {}

      if (images.indexOf(selected) === -1) {
        selected = images[Math.floor(Math.random() * images.length)];
        try {
          sessionStorage.setItem(storageKey, selected);
        } catch (error) {}
      }

      background.style.backgroundImage = "url('" + selected + "')";
    }());
  </script>
  {% endif %}

  <div class="site-hero__overlay page-hero__overlay" aria-hidden="true"></div>

  <p class="site-hero__credit page-hero__credit" aria-label="Информация об авторстве">
    Авторская учебная копия <a href="https://sit-salsk.ru/" target="_blank" rel="noopener noreferrer">официального сайта</a>. Создано студентами ГБПОУ РО «СИТ» под руководством <a href="https://бардаков.рф/" target="_blank" rel="noopener noreferrer">Бардакова Д. Н.</a>
  </p>

  <div class="site-hero__content container page-hero__content">
    <div class="site-hero__inner page-hero__inner">
      {% if hideRubric %}
      <h1 class="site-hero__organization page-hero__org" aria-label="ГБПОУ РО Сальский индустриальный техникум">
        ГБПОУ РО
        <br>
        <small>«Сальский индустриальный техникум»</small>
      </h1>
      {% else %}
      <div class="site-hero__organization page-hero__org" aria-label="ГБПОУ РО Сальский индустриальный техникум">
        ГБПОУ РО
        <br>
        <small>«Сальский индустриальный техникум»</small>
      </div>
      {% endif %}

      {% if _heroRubric and not hideRubric %}
      <hr class="site-hero__divider page-hero__divider" aria-hidden="true">
      <h1 class="site-hero__rubric page-hero__rubric">{{ _heroRubric }}</h1>
      {% endif %}

      {% if hero and hero.subtitle %}
      <p class="site-hero__subtitle page-hero__subtitle">{{ hero.subtitle }}</p>
      {% endif %}

      {% if hero and hero.cta and hero.cta.url and hero.cta.label %}
      <a href="{{ hero.cta.url }}" class="site-hero__cta btn btn-primary btn-lg page-hero__cta">{{ hero.cta.label }}</a>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}
