{#
  Компонент Секция 2 — Hero-баннер для страниц разделов (Тип B)

  Переменные:
    hero          — объект из frontmatter (обязателен для отображения):
                    hero.image    — URL фонового изображения
                    hero.title    — заголовок (по умолчанию: title страницы)
                    hero.subtitle — подзаголовок (опционально)
                    hero.alt      — alt-текст фона (опционально)
                    hero.cta      — объект { url, label } для кнопки (опционально)
    title         — заголовок страницы (fallback для hero.title)
    rubricTitle   — название рубрики под горизонтальной чертой (опционально).
                    Если не задан — используется hero.title или title.

  Если hero.image не задан — компонент не рендерится.
  Вместо него page-full.njk показывает обычный .page-title в секции-context.
#}

{% if hero and hero.image %}
<section class="section-hero page-hero component-hero" aria-label="Баннер раздела">

  <div
    class="page-hero__bg"
    style="background-image: url('{{ hero.image }}');"
    role="img"
    aria-label="{{ hero.alt or title }}"
  ></div>

  <div class="page-hero__overlay" aria-hidden="true"></div>

  <div class="container page-hero__content">
    <div class="page-hero__inner">

      {# Название организации — как на главной странице #}
      <div class="page-hero__org" aria-label="ГБПОУ РО Сальский индустриальный техникум">
        ГБПОУ РО
        <br>
        <small>«Сальский индустриальный техникум»</small>
      </div>

      {# Название рубрики под чертой #}
      {% set _heroHeading = rubricTitle or hero.title or title %}
      {% if _heroHeading %}
      <hr class="page-hero__divider" aria-hidden="true">
      <h1 class="page-hero__title">{{ _heroHeading }}</h1>
      {% endif %}

      {# Подзаголовок #}
      {% if hero.subtitle %}
      <p class="page-hero__subtitle">{{ hero.subtitle }}</p>
      {% endif %}

      {# CTA-кнопка #}
      {% if hero.cta and hero.cta.url and hero.cta.label %}
      <a href="{{ hero.cta.url }}" class="btn btn-primary btn-lg page-hero__cta">
        {{ hero.cta.label }}
      </a>
      {% endif %}

    </div>
  </div>

</section>
{% endif %}
