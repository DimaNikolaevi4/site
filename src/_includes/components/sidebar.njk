{#
  Компонент Секция 5 — Сайдбар (30% левая колонка с едиными баннерами)
  Принцип: единые баннеры на всех страницах, НЕ навигация.
  Использование:
    {% include "components/sidebar.njk" %}

  Переменные (все опциональны):
    sidebarImageBanners — массив { image, alt, url, external, title, caption }
                          для медиа-баннеров (картинка-ссылка). По умолчанию
                          выводится единый баннер БПЛА (на всех страницах).
    sidebarBanners      — массив { title, text, url, linkText, icon, modifier }
                          для текстовых баннеров (опционально).
#}

{# === Единые медиа-баннеры (картинки-ссылки) === #}
{% set _defaultImageBanners = [
  {
    image: "/images/banners/bpla.jpg",
    alt: "Стань оператором БПЛА — выбери профессию будущего",
    url: "https://xn--61-6kc3bbqgrrd.xn--p1ai/bpla.html",
    external: true
  },
  {
    image: "/images/banners/nok-2025.jpg",
    alt: "НОК-2025 — независимая оценка качества",
    url: "https://bus.gov.ru/info-card/399429",
    external: true
  }
] %}
{% set _imageBanners = sidebarImageBanners if sidebarImageBanners else _defaultImageBanners %}

{# === Текстовые баннеры (необязательные) === #}
{% set _defaultBanners = [] %}
{% set _banners = sidebarBanners if sidebarBanners else _defaultBanners %}

<aside class="component-sidebar" role="complementary" aria-label="Дополнительная информация">

  {% if _imageBanners and _imageBanners | length > 0 %}
  <div class="sidebar-image-banners">
    {% for b in _imageBanners %}
    <a class="sidebar-image-banner"
       href="{{ b.url }}"
       {% if b.external %}target="_blank" rel="noopener noreferrer"{% endif %}
       aria-label="{{ b.alt or b.title }}"
       data-aos="fade-left"
       data-aos-delay="{{ loop.index * 80 }}">
      <figure class="sidebar-image-banner__figure">
        <img class="sidebar-image-banner__img"
             src="{{ b.image }}"
             alt="{{ b.alt or b.title }}"
             loading="lazy"
             decoding="async">
        {% if b.title or b.caption %}
        <figcaption class="sidebar-image-banner__caption">
          {% if b.title %}<span class="sidebar-image-banner__title">{{ b.title }}</span>{% endif %}
          {% if b.caption %}<span class="sidebar-image-banner__text">{{ b.caption }}</span>{% endif %}
          <span class="sidebar-image-banner__cta" aria-hidden="true">
            Подробнее <i class="bi bi-arrow-right"></i>
          </span>
        </figcaption>
        {% endif %}
      </figure>
    </a>
    {% endfor %}

    {# === ПОС: Госуслуги «Решаем вместе» — третий баннер === #}
    <div id="js-show-iframe-wrapper"
         class="sidebar-pos"
         data-aos="fade-left"
         data-aos-delay="{{ (_imageBanners | length + 1) * 80 }}">
      <div class="pos-banner-fluid bf-22">
        <div class="bf-22__decor">
          <div class="bf-22__logo-wrap">
            <img class="bf-22__logo"
                 src="https://pos.gosuslugi.ru/bin/banner-fluid/gosuslugi-logo-blue.svg"
                 alt="Госуслуги"
                 loading="lazy"
                 decoding="async">
            <div class="bf-22__slogan">Решаем вместе</div>
          </div>
        </div>
        <div class="bf-22__content">
          <div class="bf-22__text">
            Не убран снег, яма на дороге, не горит фонарь?
          </div>
          <div class="bf-22__bottom-wrap">
            <div class="bf-22__btn-wrap">
              {# pos-banner-btn_2 не удалять; другие классы не добавлять #}
              <a class="pos-banner-btn_2"
                 href="https://pos.gosuslugi.ru/"
                 target="_blank"
                 rel="noopener noreferrer">Написать о проблеме</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  {% endif %}

  {% if _banners and _banners | length > 0 %}
  <div class="sidebar-banners">
    {% for banner in _banners %}
    <div class="sidebar-banner {{ banner.modifier }}" data-aos="fade-left" data-aos-delay="{{ loop.index * 80 }}">
      <div class="sidebar-banner__icon">
        <i class="bi {{ banner.icon }}" aria-hidden="true"></i>
      </div>
      <div class="sidebar-banner__body">
        <h3 class="sidebar-banner__title">{{ banner.title }}</h3>
        <p class="sidebar-banner__text">{{ banner.text }}</p>
        <a href="{{ banner.url }}" class="sidebar-banner__link">
          {{ banner.linkText }} <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

</aside>
