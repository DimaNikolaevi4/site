{# Карточка материала (превью + теги) #}
<article class="card" itemscope itemtype="https://schema.org/Article">
  {% if card.image %}
  <div class="card-image">
    <a href="{{ card.url }}">
      <img 
        src="{{ card.image }}" 
        alt="{{ card.imageAlt | default(card.title) }}"
        loading="lazy"
        itemprop="image"
      >
    </a>
  </div>
  {% endif %}
  
  <div class="card-content">
    <header class="card-header">
      {% if card.category %}
      <span class="card-category">{{ card.category }}</span>
      {% endif %}
      
      <h3 class="card-title">
        <a href="{{ card.url }}" itemprop="url">
          <span itemprop="headline">{{ card.title }}</span>
        </a>
      </h3>
      
      {% if card.date %}
      <time class="card-date" datetime="{{ card.date | dateToISO }}" itemprop="datePublished">
        {{ card.date | date: "DD.MM.YYYY" }}
      </time>
      {% endif %}
    </header>
    
    {% if card.excerpt %}
    <div class="card-excerpt" itemprop="description">
      {{ card.excerpt }}
    </div>
    {% endif %}
    
    {% if card.tags and card.tags.length > 0 %}
    <footer class="card-footer">
      <div class="card-tags">
        {% for tag in card.tags %}
          {% if tag != 'nav' %}
          <a href="/tags/{{ tag | slugify }}/" class="tag" itemprop="keywords">{{ tag }}</a>
          {% endif %}
        {% endfor %}
      </div>
    </footer>
    {% endif %}
  </div>
</article>
