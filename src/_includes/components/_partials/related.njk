{#
  Компонент: «Читайте также» (связанные материалы)
  Используется в layouts/post.njk и layouts/page.njk

  Логика выбора источника (по приоритету):
    1. relatedPages       — массив { url, title, image, excerpt, date } (явно из frontmatter)
    2. relatedCollection  — имя коллекции из collections.*
    3. category / section — slug используется как имя коллекции

  Параметры из frontmatter страницы:
    relatedPages       массив объектов — переопределение
    relatedCollection  строка — имя коллекции
    relatedCount       число (по умолчанию 3)
    relatedTitle       строка (по умолчанию «Читайте также»)

  Текущий материал (page.url) исключается из автоподбора.
#}

{% set _relItems = relatedPages %}

{% if not _relItems %}
  {% set _relCollection = relatedCollection or category or section %}
  {% set _relCount = relatedCount or 3 %}
  {% if _relCollection and collections[_relCollection] %}
    {% set _auto = [] %}
    {% for item in collections[_relCollection] | reverse %}
      {% if item.url != page.url and _auto.length < _relCount %}
        {% set _auto = (_auto.push({
          url: item.url,
          title: item.data.title,
          image: item.data.coverImage or (item.data.hero and item.data.hero.image),
          excerpt: item.data.excerpt or item.data.description,
          date: item.data.date
        }), _auto) %}
      {% endif %}
    {% endfor %}
    {% set _relItems = _auto %}
  {% endif %}
{% endif %}

{% if _relItems and _relItems.length > 0 %}
<section class="section-related" aria-label="Читайте также">
  <div class="container">
    <h2 class="section-related__title">
      <i class="bi bi-journals" aria-hidden="true"></i>
      {{ relatedTitle or 'Читайте также' }}
    </h2>
    <div class="related-grid">
      {% for item in _relItems %}
      <article class="related-card">
        {% if item.image %}
        <div class="related-card__img">
          <a href="{{ item.url }}">
            <img src="{{ item.image }}" alt="{{ item.title }}" loading="lazy">
          </a>
        </div>
        {% endif %}
        <div class="related-card__body">
          {% if item.date %}
          <time class="related-card__date" datetime="{{ item.date | dateToISO }}">
            {{ item.date | dateRu }}
          </time>
          {% endif %}
          <h3 class="related-card__title">
            <a href="{{ item.url }}">{{ item.title }}</a>
          </h3>
          {% if item.excerpt %}
          <p class="related-card__excerpt">{{ item.excerpt }}</p>
          {% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
