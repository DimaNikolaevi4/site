{# ════════════════════════════════════════════════════════════════════
   ПАРТИАЛ: _partials/share.njk — кнопки «Поделиться материалом»

   Используется в layouts/post.njk (Type C / Материал) — внизу статьи,
   между основным контентом и блоком «Читайте также».

   Состав (в порядке вывода):
     1. ВКонтакте       — vk.com/share.php
     2. Telegram        — t.me/share/url
     3. WhatsApp        — wa.me/?text= (универсально для мобильных и веба)
     4. Одноклассники   — connect.ok.ru/offer
     5. Viber           — viber://forward?text= (открывает Viber, мобильное)
     6. Почта           — mailto:?subject=&body=
     7. Копировать ссылку — navigator.clipboard.writeText (всплывающее «Скопировано»)
     8. Web Share API   — navigator.share({title,text,url}) — нативный шит iOS/Android;
                          кнопка скрыта по умолчанию и показывается крошечным инлайн-скриптом,
                          только если браузер поддерживает navigator.share
                          (gracefully degrades на десктопе/старых браузерах).

   Параметры (из контекста страницы):
     site.url   — базовый URL сайта (для построения абсолютной ссылки)
     page.url   — относительный путь страницы
     title      — заголовок материала (для текста шаринга)
     excerpt    — краткое описание (опц.; добавляется в description ВК/ОК и в WhatsApp/Telegram)
     coverImage — обложка (опц., передаётся в image для ВК)

   Параметры через frontmatter (опц.):
     share: false           — полностью скрыть блок
     shareTitle: "..."      — свой заголовок секции (default: «Поделиться материалом»)

   A11y/SEO: <aside aria-label="…">, role="list" на <ul>, aria-label на каждой
   кнопке/ссылке, target="_blank" + rel="noopener noreferrer" на внешних,
   aria-hidden="true" на декоративных иконках.
   ════════════════════════════════════════════════════════════════════ #}

{% if share != false %}
{% set _shareUrl = (site.url or '') + page.url %}
{% set _shareTitle = title or (site.name or '') %}
{% set _shareText = excerpt or description or _shareTitle %}
{% set _shareImage = coverImage or (hero and hero.image) %}

<aside class="post-share" aria-label="Поделиться материалом">
  <div class="post-share__head">
    <span class="post-share__label">
      <i class="bi bi-share-fill" aria-hidden="true"></i>
      {{ shareTitle or 'Поделиться материалом' }}
    </span>
  </div>

  <ul class="post-share__list" role="list">

    {# 1. ВКонтакте #}
    <li class="post-share__item">
      <a class="post-share__tag post-share__tag--vk"
         href="https://vk.com/share.php?url={{ _shareUrl | urlencode }}&title={{ _shareTitle | urlencode }}&description={{ _shareText | urlencode }}{% if _shareImage %}&image={{ (site.url or '') + _shareImage | urlencode }}{% endif %}&noparse=true"
         target="_blank" rel="noopener noreferrer"
         title="Поделиться ВКонтакте" aria-label="Поделиться ВКонтакте">
        <span class="post-share__icon">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M12.785 16.241s.288-.032.435-.193c.135-.148.131-.425.131-.425s-.018-1.298.582-1.494c.59-.193 1.348 1.288 2.151 1.858.607.43 1.068.336 1.068.336l2.147-.03s1.123-.071.59-.964c-.043-.073-.31-.661-1.594-1.87-1.345-1.265-1.165-1.06.456-3.243.987-1.33 1.382-2.143 1.259-2.49-.117-.331-.85-.243-.85-.243l-2.418.015s-.179-.025-.312.056c-.13.079-.213.262-.213.262s-.382 1.03-.892 1.907c-1.075 1.85-1.504 1.948-1.679 1.834-.408-.266-.306-1.075-.306-1.65 0-1.795.272-2.543-.526-2.737-.265-.064-.46-.107-1.137-.114-.87-.009-1.605.003-2.022.208-.277.135-.491.437-.361.455.16.022.523.099.715.363.249.34.24 1.105.24 1.105s.144 2.116-.337 2.376c-.329.179-.78-.187-1.74-1.866-.491-.86-.862-1.81-.862-1.81s-.072-.176-.2-.27c-.155-.114-.372-.151-.372-.151l-2.298.015s-.345.01-.471.16c-.113.135-.009.413-.009.413s1.798 4.214 3.835 6.337c1.866 1.948 3.985 1.82 3.985 1.82h.962z"/></svg>
        </span>
        <span class="post-share__tag-text">ВКонтакте</span>
      </a>
    </li>

    {# 2. Telegram #}
    <li class="post-share__item">
      <a class="post-share__tag post-share__tag--tg"
         href="https://t.me/share/url?url={{ _shareUrl | urlencode }}&text={{ _shareTitle | urlencode }}"
         target="_blank" rel="noopener noreferrer"
         title="Поделиться в Telegram" aria-label="Поделиться в Telegram">
        <span class="post-share__icon">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.5.5 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        </span>
        <span class="post-share__tag-text">Telegram</span>
      </a>
    </li>

    {# 3. WhatsApp #}
    <li class="post-share__item">
      <a class="post-share__tag post-share__tag--wa"
         href="https://wa.me/?text={{ (_shareTitle + ' ' + _shareUrl) | urlencode }}"
         target="_blank" rel="noopener noreferrer"
         title="Поделиться в WhatsApp" aria-label="Поделиться в WhatsApp">
        <span class="post-share__icon">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.885 3.488"/></svg>
        </span>
        <span class="post-share__tag-text">WhatsApp</span>
      </a>
    </li>

    {# 4. Одноклассники #}
    <li class="post-share__item">
      <a class="post-share__tag post-share__tag--ok"
         href="https://connect.ok.ru/offer?url={{ _shareUrl | urlencode }}&title={{ _shareTitle | urlencode }}&description={{ _shareText | urlencode }}"
         target="_blank" rel="noopener noreferrer"
         title="Поделиться в Одноклассниках" aria-label="Поделиться в Одноклассниках">
        <span class="post-share__icon">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M12 2.4c-2.65 0-4.8 2.15-4.8 4.8s2.15 4.8 4.8 4.8 4.8-2.15 4.8-4.8S14.65 2.4 12 2.4zm0 7.2c-1.32 0-2.4-1.08-2.4-2.4s1.08-2.4 2.4-2.4 2.4 1.08 2.4 2.4S13.32 9.6 12 9.6zm3.07 6.13c1.05-.27 2.04-.69 2.94-1.27.59-.38.76-1.16.38-1.75-.38-.59-1.16-.76-1.75-.38-1.4.9-3.05 1.38-4.74 1.38s-3.34-.48-4.74-1.38c-.59-.38-1.37-.21-1.75.38-.38.59-.21 1.37.38 1.75.9.58 1.89 1 2.94 1.27l-2.83 2.83c-.5.5-.5 1.3 0 1.79.25.25.57.37.9.37s.65-.12.9-.37l2.74-2.74 2.74 2.74c.25.25.57.37.9.37s.65-.12.9-.37c.5-.5.5-1.3 0-1.79l-2.83-2.83z"/></svg>
        </span>
        <span class="post-share__tag-text">Одноклассники</span>
      </a>
    </li>

    {# 5. Viber #}
    <li class="post-share__item">
      <a class="post-share__tag post-share__tag--viber"
         href="viber://forward?text={{ (_shareTitle + ' ' + _shareUrl) | urlencode }}"
         title="Поделиться в Viber" aria-label="Поделиться в Viber">
        <span class="post-share__icon">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M11.4 0C9.473.028 5.333.344 3.02 2.467 1.302 4.187.696 6.7.633 9.817.57 12.933.5 18.776 6.143 20.36h.005l-.005 2.42s-.034.98.61 1.18c.778.244 1.235-.5 1.978-1.302.408-.44.97-1.087 1.395-1.581 3.857.323 6.82-.418 7.156-.527.78-.255 5.184-.819 5.9-6.66.738-6.024-.36-9.832-2.34-11.55l-.012-.005c-.6-.55-3.005-2.3-8.375-2.32 0 0-.395-.025-1.057-.014m.06 1.582c.562-.004.9.018.9.018 4.542.014 6.717 1.382 7.225 1.84 1.675 1.435 2.534 4.867 1.91 9.9-.6 4.876-4.17 5.184-4.83 5.397-.282.09-2.886.738-6.16.524 0 0-2.44 2.943-3.202 3.708-.119.12-.26.167-.352.146-.131-.033-.167-.19-.165-.414l.022-4.024c-4.772-1.323-4.494-6.297-4.44-8.9.052-2.6.545-4.733 1.998-6.168 1.957-1.78 5.475-2.04 7.105-2.054l.01.027zM12.27 4c-.21 0-.376.166-.376.378 0 .211.168.378.378.378 1.32-.024 2.42.41 3.275 1.211.83.78 1.245 1.844 1.27 3.218.001.21.17.378.38.378.21 0 .377-.17.377-.38v-.011c-.026-1.572-.51-2.815-1.483-3.731-.974-.917-2.187-1.418-3.66-1.444-.05-.001-.116-.002-.16 0M5.93 5.025a.797.797 0 0 0-.405.07h-.018c-.26.155-.495.345-.74.557-.18.165-.353.32-.51.481-.346.345-.481.701-.481 1.057 0 .355.116.71.346 1.072 0 .005.01.013.014.018.197.398.515.81.93 1.318.42.514 1.075 1.137 1.84 1.787.99.84 1.785 1.405 1.785 1.405l-.005.005c.1.083.6.5 1.215.91.62.42 1.34.84 2.115 1.26.776.42 1.555.776 2.265 1.025.71.255 1.345.395 1.745.395.36 0 .71-.135 1.05-.474.166-.156.32-.33.485-.514.21-.245.4-.481.554-.74v-.018a.79.79 0 0 0 .067-.402.91.91 0 0 0-.297-.586c-.243-.222-.532-.405-.86-.6-.3-.18-.62-.36-.97-.524-.353-.165-.682-.31-.985-.405-.301-.097-.57-.156-.78-.156-.36 0-.62.1-.836.286-.181.155-.336.36-.481.585-.075.116-.155.21-.232.296-.054.06-.103.107-.143.135-.027.018-.063.046-.09.059-.097-.018-.314-.108-.53-.225-.226-.121-.51-.291-.815-.495-.605-.405-1.245-.913-1.755-1.402h-.009c-.51-.486-1-1.111-1.41-1.71-.21-.305-.387-.6-.51-.83-.116-.215-.21-.43-.225-.526.013-.027.04-.063.06-.09.027-.04.073-.09.135-.143.085-.075.18-.156.296-.232.225-.145.43-.3.585-.481.185-.215.286-.477.286-.836 0-.21-.058-.48-.156-.78-.094-.302-.24-.632-.405-.984a14.34 14.34 0 0 0-.526-.97c-.193-.328-.376-.617-.6-.86a.91.91 0 0 0-.585-.297zm6.392-.066c-.21.005-.378.176-.378.385 0 .211.166.376.376.376 1.196.04 2.213.45 3.06 1.275.847.825 1.265 1.84 1.276 3.045 0 .21.169.378.378.378.21 0 .377-.169.378-.379-.013-1.421-.504-2.629-1.503-3.6-1-.972-2.224-1.475-3.6-1.485-.005-.005-.013 0-.013 0z"/></svg>
        </span>
        <span class="post-share__tag-text">Viber</span>
      </a>
    </li>

    {# 6. Почта #}
    <li class="post-share__item">
      <a class="post-share__tag post-share__tag--mail"
         href="mailto:?subject={{ _shareTitle | urlencode }}&body={{ (_shareText + '%0A%0A' + _shareUrl) | urlencode }}"
         title="Отправить по почте" aria-label="Отправить по почте">
        <span class="post-share__icon"><i class="bi bi-envelope" aria-hidden="true"></i></span>
        <span class="post-share__tag-text">Почта</span>
      </a>
    </li>

    {# 7. Копировать ссылку #}
    <li class="post-share__item">
      <button class="post-share__tag post-share__tag--copy post-share__tag--btn"
              type="button"
              title="Копировать ссылку"
              aria-label="Копировать ссылку"
              onclick="(function(b){navigator.clipboard.writeText('{{ _shareUrl }}').then(function(){var t=b.querySelector('.post-share__tag-text');var o=t.textContent;t.textContent='Скопировано';b.classList.add('is-copied');setTimeout(function(){t.textContent=o;b.classList.remove('is-copied');},1600);});})(this)">
        <span class="post-share__icon"><i class="bi bi-link-45deg" aria-hidden="true"></i></span>
        <span class="post-share__tag-text">Копировать ссылку</span>
      </button>
    </li>

    {# 8. Web Share API — нативный шит iOS/Android, скрыт по умолчанию,
         показывается крошечным инлайн-скриптом ниже только при поддержке
         navigator.share (gracefully degrades на десктопе/старых браузерах). #}
    <li class="post-share__item post-share__item--native" hidden>
      <button class="post-share__tag post-share__tag--native post-share__tag--btn"
              type="button"
              title="Поделиться (системный диалог)"
              aria-label="Поделиться через системный диалог"
              onclick="navigator.share({title:'{{ _shareTitle | replace("'", "\\'") }}',text:'{{ _shareText | replace("'", "\\'") }}',url:'{{ _shareUrl }}'}).catch(function(){});">
        <span class="post-share__icon"><i class="bi bi-share" aria-hidden="true"></i></span>
        <span class="post-share__tag-text">Поделиться…</span>
      </button>
    </li>

  </ul>
</aside>

<script>
  // Web Share API: показать кнопку только если браузер поддерживает navigator.share
  if (typeof navigator !== 'undefined' && typeof navigator.share === 'function') {
    var _ns = document.currentScript && document.currentScript.previousElementSibling;
    if (_ns) {
      var _native = _ns.querySelector('.post-share__item--native');
      if (_native) _native.removeAttribute('hidden');
    }
  }
</script>
{% endif %}
