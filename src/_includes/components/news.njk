{#
  Компонент Секция 5 — Новости
  Режимы:
    newsMode = 'latest'    → 3 последние новости (для главной)
    newsMode = 'subrubrics'→ список подрубрик текущего раздела (для страниц разделов)
  Переменные:
    newsMode       — строка (обязательно)
    newsCount      — кол-во новостей (по умолчанию 3, только для 'latest')
    newsCollection — коллекция для фильтрации подрубрик (только для 'subrubrics')
    newsTitle      — заголовок секции (по умолчанию «Новости»)
    newsSubtitle   — подзаголовок (опционально)
#}

{% set _newsCount = newsCount if newsCount else 3 %}
{% set _newsTitle = newsTitle if newsTitle else "Новости" %}

{# ── Режим 1: Последние новости (главная) ── #}
{% if newsMode == 'latest' %}

<section id="news" class="section component-news component-news--latest">

  <div class="container section-title" data-aos="fade-up">
    <h2>{{ _newsTitle }}</h2>
    {% if newsSubtitle %}
    <p>{{ newsSubtitle }}</p>
    {% else %}
    <p>Последние события техникума</p>
    {% endif %}
  </div>

  <div class="container">
    <div class="row">
      {% set latestNews = collections.news | reverse %}
      {% for post in latestNews %}
      {% if loop.index <= _newsCount %}
      <div class="col-lg-4 col-md-6 d-flex align-items-stretch mb-4" data-aos="zoom-in" data-aos-delay="{{ loop.index * 100 }}">
        <div class="course-item w-100">
          <img
            src="{{ post.data.image or '/assets/mentor/img/course-' ~ loop.index ~ '.jpg' }}"
            class="img-fluid"
            alt="{{ post.data.title }}"
            loading="lazy"
          >
          <div class="course-content">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <p class="category">{{ post.data.category or 'Новости' }}</p>
              <p class="date">{{ post.date | dateRu }}</p>
            </div>
            <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <p class="description">
              {{ post.data.excerpt or (post.templateContent | truncate(120)) }}
            </p>
            <div class="trainer d-flex justify-content-between align-items-center">
              <div class="trainer-profile d-flex align-items-center">
                <a href="{{ post.url }}" class="trainer-link">Читать далее →</a>
              </div>
            </div>
          </div>
        </div>
      </div>
      {% endif %}
      {% else %}
      <div class="col-12 text-center">
        <p class="text-muted">Новости пока не добавлены.</p>
      </div>
      {% endfor %}
    </div>

    <div class="text-center mt-4" data-aos="fade-up" data-aos-delay="400">
      <a href="/news/" class="btn-get-started">Все новости</a>
    </div>
  </div>

</section>

{# ── Режим 2: Список подрубрик раздела (страницы разделов) ── #}
{% elif newsMode == 'subrubrics' %}

<section class="section component-news component-news--subrubrics">

  <div class="container">
    {% if newsTitle %}
    <div class="section-title mb-4" data-aos="fade-up">
      <h2>{{ _newsTitle }}</h2>
    </div>
    {% endif %}

    {% if newsCollection and newsCollection.length > 0 %}
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      {% for item in newsCollection %}
      <div class="col" data-aos="fade-up" data-aos-delay="{{ loop.index * 50 }}">
        <article class="subrubric-card h-100">
          {% if item.data.image %}
          <a href="{{ item.url }}" class="subrubric-card__img-wrap">
            <img src="{{ item.data.image }}" alt="{{ item.data.title }}" loading="lazy" class="img-fluid">
          </a>
          {% endif %}
          <div class="subrubric-card__body">
            <h3 class="subrubric-card__title">
              <a href="{{ item.url }}">{{ item.data.title }}</a>
            </h3>
            {% if item.data.description %}
            <p class="subrubric-card__desc">{{ item.data.description }}</p>
            {% endif %}
            <a href="{{ item.url }}" class="subrubric-card__link">
              Перейти <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </article>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="alert alert-info" role="status">
      <i class="bi bi-info-circle me-2"></i>Материалы в этом разделе пока не добавлены.
    </div>
    {% endif %}
  </div>

</section>

{% endif %}
