<footer class="footer" role="contentinfo">
  <div class="container footer__container">
    <div class="footer__section">
      <h3 class="footer__title">{{ site.name }}</h3>
      <p class="footer__address">{{ site.address }}</p>
      <p class="footer__phone">{{ site.phone }}</p>
      <p class="footer__email">{{ site.email }}</p>
    </div>
    
    <div class="footer__section">
      <h4 class="footer__subtitle">Навигация</h4>
      <ul class="footer__menu">
        <li><a href="/">Главная</a></li>
        <li><a href="/news/">Новости</a></li>
        <li><a href="/about/">О техникуме</a></li>
        <li><a href="/contacts/">Контакты</a></li>
      </ul>
    </div>
    
    <div class="footer__section">
      <h4 class="footer__subtitle">Документы</h4>
      <ul class="footer__menu">
        <li><a href="/documents/">Документы</a></li>
        <li><a href="/education/">Образование</a></li>
        <li><a href="/admission/">Абитуриенту</a></li>
      </ul>
    </div>
  </div>
  
  <div class="footer__bottom">
    <div class="container">
      <p>&copy; {{ site.copyright }} {{ site.name }}</p>
    </div>
  </div>
</footer>
