{# ════════════════════════════════════════════════════════════════════
   КОМПОНЕНТ: Секция 8 — Footer (канон §3.0.1)

   Глобальный «подвал» сайта. Подключается ОДИН раз в `base.njk`
   (стр. 117) — присутствует на всех страницах: главной, разделах,
   материалах, страницах «Сведений» и листингах. Не настраивается
   через frontmatter.

   Источники данных:
     • _data/site.yaml      — name, full_name, short_name, description,
                              founded, director, copyright, license,
                              accreditation, legacy_url
     • _data/contacts.yaml  — corps[] (для блока корпусов: имя, адрес,
                              телефоны с метками), email_admin,
                              email_support, phone_link, working_hours,
                              eos_url
     • _data/social.yaml    — vk, rutube

   Структура (4 крупных блока):
     1. Верхний блок (.footer-top):
        - Бренд (лого + tagline + meta + соцсети)
        - Корпуса (цикл по contacts.corps[])
        - Колонки «Навигация» (5 ссылок захардкожены) + «Связь с нами»
     2. Официальные ресурсы — 12 захардкоженных карточек-ссылок на
        министерства/ведомства РФ и Ростовской области; иконки лежат
        в /images/ikonccilki/ (passthrough из src/images).
     3. Лицензии (опц.) — site.license + site.accreditation.
     4. Нижний блок (.footer-bottom): copyright + sitemap.xml + admin/ +
        legacy_url.

   + кнопка #scroll-top вне .container.

   A11y: <footer role="contentinfo">, aria-label на лого, visually-hidden
   подписи на иконках соцсетей, aria-labelledby на блоке ресурсов,
   aria-hidden на декоре, loading="lazy" на иконках, target="_blank"
   + rel="noopener" на внешних ссылках.
   ════════════════════════════════════════════════════════════════════ #}
<footer id="footer" class="site-footer" role="contentinfo">
  <div class="footer-decoration" aria-hidden="true"></div>

  <div class="container">

    {# ============ ВЕРХНИЙ БЛОК ============ #}
    <div class="footer-top">

      {# --- Бренд --- #}
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="На главную">
          <img src="/assets/images/logo.png" alt="" class="footer-logo-mark" aria-hidden="true" width="48" height="48" loading="lazy" decoding="async">
          <div class="footer-logo-text">
            <span class="footer-logo-org">ГБПОУ РО</span>
            <span class="footer-logo-name">«Сальский индустриальный техникум»</span>
          </div>
        </a>
        <p class="footer-tagline">{{ site.description }}</p>

        <div class="footer-meta">
          {% if site.founded %}<div class="footer-meta-item"><i class="bi bi-mortarboard-fill" aria-hidden="true"></i> Основан в {{ site.founded }} году</div>{% endif %}
          {% if site.director %}<div class="footer-meta-item"><i class="bi bi-person-badge-fill" aria-hidden="true"></i> Директор: {{ site.director }}</div>{% endif %}
        </div>

        <div class="footer-social" aria-label="Социальные сети">
          {% if social.vk %}
          <a href="{{ social.vk }}" target="_blank" rel="noopener" class="footer-social-link" aria-label="ВКонтакте">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M21.579 6.855c.17-.565 0-.98-.802-.98h-2.652c-.67 0-.979.357-1.146.752 0 0-1.34 3.283-3.237 5.414-.614.618-.893.814-1.228.814-.17 0-.42-.196-.42-.76V6.854c0-.671-.19-.98-.76-.98H9.389c-.42 0-.67.315-.67.615 0 .644.96.793 1.06 2.605v3.935c0 .864-.155 1.021-.492 1.021-.893 0-3.066-3.303-4.355-7.083C4.68 6.37 4.428 5.875 3.754 5.875H1.102c-.76 0-.913.357-.913.752 0 .704.893 4.197 4.155 8.817 2.175 3.144 5.239 4.848 8.026 4.848 1.674 0 1.88-.38 1.88-1.035v-2.385c0-.76.16-.912.694-.912.393 0 1.067.198 2.641 1.727 1.798 1.81 2.094 2.62 3.102 2.62h2.652c.76 0 1.14-.38.92-1.134-.237-.744-1.092-1.82-2.226-3.101-.614-.73-1.535-1.517-1.814-1.91-.393-.508-.28-.733 0-1.185 0 0 3.21-4.55 3.546-6.095z"/></svg>
            <span class="visually-hidden">ВКонтакте</span>
          </a>
          {% endif %}
          {% if social.rutube %}
          <a href="{{ social.rutube }}" target="_blank" rel="noopener" class="footer-social-link" aria-label="RuTube">
            <i class="bi bi-play-circle-fill" aria-hidden="true"></i>
            <span class="visually-hidden">RuTube</span>
          </a>
          {% endif %}
          {% if contacts.email %}
          <a href="mailto:{{ contacts.email }}" class="footer-social-link" aria-label="Электронная почта">
            <i class="bi bi-envelope-fill" aria-hidden="true"></i>
            <span class="visually-hidden">Email</span>
          </a>
          {% endif %}
          {% if contacts.phone_link %}
          <a href="{{ contacts.phone_link }}" class="footer-social-link" aria-label="Позвонить">
            <i class="bi bi-telephone-fill" aria-hidden="true"></i>
            <span class="visually-hidden">Телефон</span>
          </a>
          {% endif %}
        </div>
      </div>

      {# --- Корпуса --- #}
      <div class="footer-corps-wrap">
        {% for corp in contacts.corps %}
        <div class="footer-corp-card">
          <div class="footer-corp-header">
            <i class="bi bi-building" aria-hidden="true"></i>
            <h4 class="footer-corp-title">{{ corp.name }}</h4>
          </div>
          {% if corp.address %}
          <p class="footer-corp-address">
            <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
            <span>{{ corp.address }}</span>
          </p>
          {% endif %}
          <ul class="footer-corp-phones">
            {% for ph in corp.phones %}
            <li>
              <span class="footer-phone-label">{{ ph.label }}</span>
              <a href="tel:{{ ph.phone }}" class="footer-phone-link">{{ ph.phone_formatted }}</a>
            </li>
            {% endfor %}
          </ul>
        </div>
        {% endfor %}
      </div>

      {# --- Колонка: разделы + контакты --- #}
      <div class="footer-nav">
        <div class="footer-nav-block">
          <h4 class="footer-heading">Навигация</h4>
          <ul class="footer-links">
            <li><a href="/"><i class="bi bi-chevron-right" aria-hidden="true"></i>Главная</a></li>
            <li><a href="/svedenija/"><i class="bi bi-chevron-right" aria-hidden="true"></i>Сведения об организации</a></li>
            <li><a href="/abiturientam/"><i class="bi bi-chevron-right" aria-hidden="true"></i>Абитуриентам</a></li>
            <li><a href="/studentam-i-roditeljam/"><i class="bi bi-chevron-right" aria-hidden="true"></i>Студентам и родителям</a></li>
            <li><a href="/news/"><i class="bi bi-chevron-right" aria-hidden="true"></i>Новости</a></li>
          </ul>
        </div>

        <div class="footer-nav-block">
          <h4 class="footer-heading">Связь с нами</h4>
          <ul class="footer-contacts">
            <li>
              <i class="bi bi-clock-fill" aria-hidden="true"></i>
              <span>{{ contacts.working_hours }}</span>
            </li>
            {% if contacts.email_admin %}
            <li>
              <i class="bi bi-envelope-fill" aria-hidden="true"></i>
              <a href="mailto:{{ contacts.email_admin }}">{{ contacts.email_admin }}</a>
              <small class="footer-contact-hint">администрация</small>
            </li>
            {% endif %}
            {% if contacts.email_support %}
            <li>
              <i class="bi bi-headset" aria-hidden="true"></i>
              <a href="mailto:{{ contacts.email_support }}">{{ contacts.email_support }}</a>
              <small class="footer-contact-hint">техподдержка</small>
            </li>
            {% endif %}
            {% if contacts.eos_url %}
            <li>
              <i class="bi bi-laptop" aria-hidden="true"></i>
              <a href="{{ contacts.eos_url }}" target="_blank" rel="noopener">ЭОС — обучение онлайн</a>
            </li>
            {% endif %}
          </ul>
        </div>
      </div>
    </div>

    {# ============ ОФИЦИАЛЬНЫЕ РЕСУРСЫ ============ #}
    <section class="footer-resources" aria-labelledby="footer-resources-title">
      <h4 id="footer-resources-title" class="footer-heading footer-resources-title">Официальные ресурсы</h4>
      <ul class="footer-resources-grid">
        <li>
          <a href="http://government.ru/" target="_blank" rel="noopener" class="footer-resource" title="Правительство Российской Федерации">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/government.svg" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Официальный сайт<br>Правительства России</span>
          </a>
        </li>
        <li>
          <a href="https://epp.genproc.gov.ru/" target="_blank" rel="noopener" class="footer-resource" title="Генеральная прокуратура Российской Федерации">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/prok-rf.webp" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Генеральная прокуратура<br>Российской Федерации</span>
          </a>
        </li>
        <li>
          <a href="https://mintrud.gov.ru/" target="_blank" rel="noopener" class="footer-resource" title="Министерство труда и социальной защиты">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/min-tr.webp" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Министерство труда<br>и социальной защиты</span>
          </a>
        </li>
        <li>
          <a href="https://obrnadzor.gov.ru/" target="_blank" rel="noopener" class="footer-resource" title="Рособрнадзор">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/cropped-logo_rosobrnadzor-2.png" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Федеральная служба по надзору<br>в сфере образования и науки</span>
          </a>
        </li>
        <li>
          <a href="https://www.kremlin.ru/" target="_blank" rel="noopener" class="footer-resource" title="Президент Российской Федерации">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/pr-rf.webp" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Сайт Президента<br>Российской Федерации</span>
          </a>
        </li>
        <li>
          <a href="https://gosnadzor.ru/" target="_blank" rel="noopener" class="footer-resource" title="Ростехнадзор">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/rtn.webp" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Федеральная служба по экологическому,<br>технологическому и атомному надзору</span>
          </a>
        </li>
        <li>
          <a href="https://edu.gov.ru/" target="_blank" rel="noopener" class="footer-resource" title="Министерство просвещения">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/min-pr.webp" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Министерство просвещения<br>Российской Федерации</span>
          </a>
        </li>
        <li>
          <a href="https://rostrud.gov.ru/" target="_blank" rel="noopener" class="footer-resource" title="Роструд">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/rostrud.gov.svg" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Федеральная служба<br>по труду и занятости</span>
          </a>
        </li>
        <li>
          <a href="https://www.mchs.gov.ru/" target="_blank" rel="noopener" class="footer-resource" title="МЧС России">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/MCHS.webp" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Официальный сайт<br>МЧС России</span>
          </a>
        </li>
        <li>
          <a href="https://www.minobrnauki.gov.ru/" target="_blank" rel="noopener" class="footer-resource" title="Минобрнауки России">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/MNVO.webp" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Министерство науки<br>и высшего образования РФ</span>
          </a>
        </li>
        <li>
          <a href="https://www.donland.ru/" target="_blank" rel="noopener" class="footer-resource" title="Правительство Ростовской области">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/don-logo.svg" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Официальный портал<br>Правительства Ростовской области</span>
          </a>
        </li>
        <li>
          <a href="https://minobr.donland.ru/" target="_blank" rel="noopener" class="footer-resource" title="Министерство общего и профессионального образования Ростовской области">
            <span class="footer-resource-icon"><img src="/images/ikonccilki/%D0%BB%D0%BE%D0%B3%D0%BE_%D0%BC%D0%B8%D0%BD_%D1%80%D0%BE%D1%81%D1%82.png" alt="" loading="lazy"></span>
            <span class="footer-resource-text">Министерство общего и профессионального<br>образования Ростовской области</span>
          </a>
        </li>
      </ul>
    </section>

    {# ============ ЛИЦЕНЗИИ ============ #}
    {% if site.license or site.accreditation %}
    <div class="footer-legal">
      {% if site.license %}<span class="footer-legal-item"><strong>Лицензия:</strong> {{ site.license }}</span>{% endif %}
      {% if site.accreditation %}<span class="footer-legal-item"><strong>Аккредитация:</strong> {{ site.accreditation }}</span>{% endif %}
    </div>
    {% endif %}

    <hr class="brand-divider brand-divider--light brand-divider--wide" aria-hidden="true">

    {# ============ НИЖНИЙ БЛОК ============ #}
    <div class="footer-bottom">
      <p class="footer-copyright">
        © {{ site.copyright or "2026" }} {{ site.full_name or site.name }}.<br>
        Все права защищены.
      </p>
      <p class="footer-authorship">
        Авторская учебная копия <a href="https://sit-salsk.ru/" target="_blank" rel="noopener">официального сайта</a>. Создано студентами ГБПОУ РО «СИТ» под руководством <a href="https://бардаков.рф/" target="_blank" rel="noopener">Бардакова Д. Н.</a>
      </p>
      <div class="footer-bottom-links">
        <a href="/privacy/">Политика конфиденциальности</a>
        <span aria-hidden="true">·</span>
        <a href="/sitemap.xml">Карта сайта</a>
        <span aria-hidden="true">·</span>
        <a href="/admin/">Администрирование</a>
      </div>
    </div>
  </div>

  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center" aria-label="Наверх">
    <i class="bi bi-arrow-up-short"></i>
  </a>
</footer>
