<footer id="footer" class="footer position-relative light-background" role="contentinfo">
  <div class="container footer-top">
    <div class="row gy-4">
      <div class="col-lg-4 col-md-6 footer-about">
        <a href="/" class="logo d-flex align-items-center">
          <span class="sitename">{{ site.short_name or site.name }}</span>
        </a>
        <div class="footer-contact pt-3">
          <p>{{ site.address }}</p>
          <p class="mt-3"><strong>Телефон:</strong> <span>{{ site.phone }}</span></p>
          <p><strong>Email:</strong> <span>{{ site.email }}</span></p>
        </div>
        <div class="social-links d-flex mt-4">
          {% if site.social and site.social.vk %}<a href="{{ site.social.vk }}" aria-label="ВКонтакте"><i class="bi bi-vk"></i></a>{% endif %}
          {% if site.social and site.social.telegram %}<a href="{{ site.social.telegram }}" aria-label="Telegram"><i class="bi bi-telegram"></i></a>{% endif %}
        </div>
      </div>

      <div class="col-lg-2 col-md-3 footer-links">
        <h4>Разделы</h4>
        <ul>
          <li><a href="/">Главная</a></li>
          <li><a href="/about/">О техникуме</a></li>
          <li><a href="/news/">Новости</a></li>
          <li><a href="/search/">Поиск</a></li>
        </ul>
      </div>

      <div class="col-lg-2 col-md-3 footer-links">
        <h4>Информация</h4>
        <ul>
          <li><a href="/svedenija/">Сведения</a></li>
          <li><a href="/abiturientam/">Абитуриентам</a></li>
          <li><a href="/studentam-roditeljam/">Студентам и родителям</a></li>
          <li><a href="/bezopasnost/">Безопасность</a></li>
        </ul>
      </div>

      <div class="col-lg-4 col-md-12 footer-newsletter">
        <h4>Подписка на новости</h4>
        <p>Подпишитесь, чтобы получать обновления о событиях и жизни техникума.</p>
        <form action="/forms/newsletter.php" method="post" class="php-email-form">
          <div class="newsletter-form"><input type="email" name="email" placeholder="Ваш e-mail"><input type="submit" value="Подписаться"></div>
          <div class="loading">Отправка...</div>
          <div class="error-message"></div>
          <div class="sent-message">Заявка успешно отправлена.</div>
        </form>
      </div>
    </div>
  </div>

  <div class="container copyright text-center mt-4">
    <p>&copy; <span>{{ site.copyright }}</span> <strong class="px-1 sitename">{{ site.short_name or site.name }}</strong> <span>Все права защищены</span></p>
    <div class="credits">
      Дизайн на основе шаблона <a href="https://bootstrapmade.com/mentor-free-education-bootstrap-theme/">Mentor</a>
    </div>
  </div>

  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center" aria-label="Наверх">
    <i class="bi bi-arrow-up-short"></i>
  </a>
  <div id="preloader"></div>
</footer>
