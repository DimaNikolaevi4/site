{#
  Компонент — Хлебные крошки (Schema.org BreadcrumbList)
  Единая точка рендеринга: заменяет partials/breadcrumbs.njk и инлайн-код в post.njk

  Приоритеты построения цепочки:
    1. Ручной массив `breadcrumbs` — полный контроль. Каждый элемент: { text, url }.
       Последний элемент считается текущей страницей (без ссылки).
    2. Авто-режим через frontmatter — section/sectionTitle, category/categoryTitle,
       subsection/subsectionTitle, title.
       Корректно показывает метки, а не технические ключи.

  Переменные для ручного режима:
    breadcrumbs  — массив [{ text, url }, …]. Последний элемент — без url (текущая страница).

  Переменные для авто-режима (из frontmatter страницы):
    section        — slug родительского раздела (напр. "abiturientam")
    sectionTitle   — метка раздела (напр. "Абитуриентам"). Если нет — используется section.
    category       — альтернатива section (для материалов)
    categoryTitle  — метка категории. Если нет — используется category.
    subsection     — slug подраздела (уровень 2, опционально)
    subsectionTitle— метка подраздела. Если нет — используется subsection.
    title          — заголовок текущей страницы (последний элемент, без ссылки)
#}

<nav class="breadcrumbs component-breadcrumbs" aria-label="Хлебные крошки">
  <ol class="breadcrumb-list"
      itemscope
      itemtype="https://schema.org/BreadcrumbList">

    {# ── Режим 1: ручной массив ── #}
    {% if breadcrumbs and breadcrumbs.length > 0 %}

      {% for crumb in breadcrumbs %}
      <li class="breadcrumb-item{% if loop.last %} breadcrumb-item--current{% endif %}"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem">
        {% if not loop.last and crumb.url %}
          <a href="{{ crumb.url }}" itemprop="item">
            <span itemprop="name">{{ crumb.text }}</span>
          </a>
        {% else %}
          <span itemprop="name">{{ crumb.text }}</span>
        {% endif %}
        <meta itemprop="position" content="{{ loop.index }}"/>
      </li>
      {% endfor %}

    {# ── Режим 2: авто через frontmatter ── #}
    {% else %}

      {# Главная — всегда первая #}
      <li class="breadcrumb-item"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem">
        <a href="/" itemprop="item">
          <span itemprop="name">Главная</span>
        </a>
        <meta itemprop="position" content="1"/>
      </li>

      {# Уровень 1: раздел (section) или категория (category) #}
      {% if section %}
      <li class="breadcrumb-item"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem">
        <a href="/{{ section }}/" itemprop="item">
          <span itemprop="name">{{ sectionTitle or section }}</span>
        </a>
        <meta itemprop="position" content="2"/>
      </li>
      {% elif category %}
      <li class="breadcrumb-item"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem">
        <a href="/{{ category }}/" itemprop="item">
          <span itemprop="name">{{ categoryTitle or category }}</span>
        </a>
        <meta itemprop="position" content="2"/>
      </li>
      {% endif %}

      {# Уровень 2: подраздел (subsection) — опциональный #}
      {% if subsection %}
      <li class="breadcrumb-item"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem">
        <a href="/{{ section or category }}/{{ subsection }}/" itemprop="item">
          <span itemprop="name">{{ subsectionTitle or subsection }}</span>
        </a>
        <meta itemprop="position" content="3"/>
      </li>
      {% endif %}

      {# Текущая страница (без ссылки) #}
      {% if title %}
      <li class="breadcrumb-item breadcrumb-item--current"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem">
        <span itemprop="name">{{ title }}</span>
        <meta itemprop="position"
              content="{{ 4 if subsection else (3 if (section or category) else 2) }}"/>
      </li>
      {% endif %}

    {% endif %}

  </ol>
</nav>
