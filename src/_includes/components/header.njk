<!-- Offcanvas панель с рубриками (простой аккордеон) -->  
<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasRubrics" aria-labelledby="offcanvasRubricsLabel">  
  <div class="offcanvas-header">  
    <h5 class="offcanvas-title" id="offcanvasRubricsLabel">Разделы сайта</h5>  
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Закрыть"></button>  
  </div>  
  <div class="offcanvas-body">  
    {% macro renderRubrics(items, level=1) %}  
      <ul class="list-unstyled {% if level > 1 %}ms-3{% endif %}">  
        {% for item in items %}  
          <li>  
            {% if item.children %}  
              <button class="btn btn-link w-100 text-start d-flex justify-content-between align-items-center"   
                      type="button"   
                      data-bs-toggle="collapse"   
                      data-bs-target="#collapse-{{ item.slug }}"   
                      aria-expanded="false"  
                      title="{{ item.title }}">  
                <span>{{ item.title }}</span>  
                <i class="bi bi-chevron-down transition"></i>  
              </button>  
              <div class="collapse" id="collapse-{{ item.slug }}">  
                {{ renderRubrics(item.children, level + 1) }}  
              </div>  
            {% else %}  
              <a href="/{{ item.slug }}/"   
                 class="d-block py-1 text-decoration-none"   
                 data-bs-dismiss="offcanvas"  
                 title="{{ item.title }}">  
                {{ item.title }}  
              </a>  
            {% endif %}  
          </li>  
        {% endfor %}  
      </ul>  
    {% endmacro %}  
    
    {{ renderRubrics(rubrics.main_rubrics) }}  
  </div>  
</div>  

<i class="mobile-nav-toggle d-xl-none bi bi-list" aria-hidden="true"></i>