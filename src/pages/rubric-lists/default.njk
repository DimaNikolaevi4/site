---
layout: layouts/base.njk
permalink: false
eleventyExcludeFromCollections: true
title: Список материалов
description: Материалы по специальности
rubric:
  title: Информационные системы и программирование
  code: 09.02.07
pagination:
  data: collections.all
  size: 10
  alias: posts
---

<nav class="breadcrumbs" aria-label="Хлебные крошки">
  <div class="container">
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a href="/" class="breadcrumbs__link">Главная</a>
      </li>
      <li class="breadcrumbs__item">
        <a href="/specialties/" class="breadcrumbs__link">Специальности</a>
      </li>
      <li class="breadcrumbs__item breadcrumbs__item--active" aria-current="page">
        {{ title }}
      </li>
    </ol>
  </div>
</nav>

<section class="section section--header">
  <div class="container">
    <h1 class="page-title">{{ rubric.title }}</h1>
    <p class="page-subtitle">Код специальности: {{ rubric.code }}</p>
  </div>
</section>

<div class="container layout layout--with-sidebar">
  <main class="layout__content">
    <div class="filters">
      <form class="filters__form" role="search">
        <input type="search" class="filters__input" placeholder="Поиск материалов..." aria-label="Поиск">
        <button type="submit" class="btn btn--primary">Найти</button>
      </form>
    </div>

    <div class="materials-list">
      {% for post in posts %}
      <article class="material-card">
        <h2 class="material-card__title">
          <a href="{{ post.url }}">{{ post.data.title or post.fileSlug }}</a>
        </h2>
        {% if post.data.excerpt %}
        <p class="material-card__excerpt">{{ post.data.excerpt }}</p>
        {% endif %}
      </article>
      {% endfor %}
    </div>

    <nav class="pagination" aria-label="Пагинация">
      <ul class="pagination__list">
        {% if pagination.href.previous %}
        <li class="pagination__item pagination__item--prev">
          <a href="{{ pagination.href.previous }}" class="pagination__link">← Назад</a>
        </li>
        {% endif %}

        {% for entry in pagination.pages %}
        <li class="pagination__item">
          <a href="{{ pagination.hrefs[loop.index0] }}" class="pagination__link {% if entry.url == page.url %}active{% endif %}">
            {{ loop.index }}
          </a>
        </li>
        {% endfor %}

        {% if pagination.href.next %}
        <li class="pagination__item pagination__item--next">
          <a href="{{ pagination.href.next }}" class="pagination__link">Вперед →</a>
        </li>
        {% endif %}
      </ul>
    </nav>
  </main>

  <aside class="layout__sidebar" role="complementary">
    <nav class="sidebar-nav">
      <h3 class="sidebar-nav__title">Разделы</h3>
      <ul class="sidebar-nav__list">
        <li><a href="#" class="sidebar-nav__link sidebar-nav__link--active">Все материалы</a></li>
        <li><a href="#" class="sidebar-nav__link">Методические указания</a></li>
        <li><a href="#" class="sidebar-nav__link">Лабораторные работы</a></li>
        <li><a href="#" class="sidebar-nav__link">Курсовые проекты</a></li>
        <li><a href="#" class="sidebar-nav__link">Экзаменационные материалы</a></li>
      </ul>
    </nav>

    <div class="sidebar-block">
      <h3 class="sidebar-block__title">Полезные ссылки</h3>
      <ul class="sidebar-block__list">
        <li><a href="#">Расписание</a></li>
        <li><a href="#">Электронный журнал</a></li>
        <li><a href="#">Библиотека</a></li>
      </ul>
    </div>
  </aside>
</div>
