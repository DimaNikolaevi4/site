{%- if collections.tagsList and collections.tagsList.length > 0 -%}
<ul class="tags-cloud" aria-label="Облако тегов">
{%- for t in collections.tagsList -%}
<li class="tags-cloud__item"><a href="/tags/{{ t.slug }}/" class="tag tags-cloud__link">{{ t.name }} <span class="tags-cloud__count" aria-label="публикаций: {{ t.posts.length }}">{{ t.posts.length }}</span></a></li>
{%- endfor -%}
</ul>
{%- else -%}
<p>Пока нет ни одного тега.</p>
{%- endif -%}
