---
layout: layouts/base.njk
pagination:
  data: collections.news
  size: 1
  alias: post
permalink: "{{ post.url }}"
---

<!-- Хлебные крошки -->
<nav class="breadcrumbs" aria-label="Хлебные крошки">
  <div class="container">
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a href="/" class="breadcrumbs__link">Главная</a>
      </li>
      <li class="breadcrumbs__item">
        <a href="/news/" class="breadcrumbs__link">Новости</a>
      </li>
      <li class="breadcrumbs__item breadcrumbs__item--active" aria-current="page">
        {{ post.data.title }}
      </li>
    </ol>
  </div>
</nav>

<!-- Заголовок новости -->
<section class="section section--header">
  <div class="container">
    <h1 class="page-title">{{ post.data.title }}</h1>
    <div class="material-meta">
      <time class="material-meta__date" datetime="{{ post.date }}">
        {{ post.date | dateRu }}
      </time>
      {% if post.data.category %}
      <span class="material-meta__category">{{ post.data.category }}</span>
      {% endif %}
    </div>
  </div>
</section>

<!-- Основной контент -->
<div class="container layout">
  <main class="layout__content layout__content--full news-content">
    {{ post.templateContent | safe }}
  </main>
</div>

<!-- Другие новости -->
<section class="section">
  <div class="container">
    <h2 class="section-title">Другие новости</h2>
    <div class="news-grid">
      {% for other in collections.news | reverse %}
        {% if other.url != post.url %}
          {% if loop.index <= 3 %}
          <article class="news-card">
            <time class="news-card__date" datetime="{{ other.date }}">{{ other.date | dateRu }}</time>
            <h3 class="news-card__title">
              <a href="{{ other.url }}">{{ other.data.title }}</a>
            </h3>
            <p class="news-card__excerpt">{{ other.data.excerpt or other.templateContent | truncate(150) }}</p>
            <a href="{{ other.url }}" class="news-card__link">Читать далее →</a>
          </article>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
