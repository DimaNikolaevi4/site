---
layout: layouts/base.njk
pagination:
  data: collections.news
  size: 1
  alias: post
---

<div class="page-hero">
  <div class="container">
    <nav class="page-hero__breadcrumbs" aria-label="Хлебные крошки">
      <ol>
        <li><a href="/">Главная</a></li>
        <li><a href="/news/">Новости</a></li>
        <li>{{ post.data.title }}</li>
      </ol>
    </nav>
    <h1 class="page-hero__title">{{ post.data.title }}</h1>
    <div class="page-hero__meta">
      <time datetime="{{ post.date }}">{{ post.date | dateRu }}</time>
      {% if post.data.category %}
      <span>{{ post.data.category }}</span>
      {% endif %}
    </div>
  </div>
</div>

<!-- Основной контент -->
<div class="container layout">
  <main class="layout__content layout__content--full news-content">
    {{ post.templateContent | safe }}
  </main>
</div>

<!-- Другие новости -->
<section class="section">
  <div class="container">
    <h2 class="section-title">Другие новости</h2>
    <div class="news-grid">
      {% for other in collections.news | reverse %}
        {% if other.url != post.url %}
          {% if loop.index <= 3 %}
          <article class="news-card">
            <time class="news-card__date" datetime="{{ other.date }}">{{ other.date | dateRu }}</time>
            <h3 class="news-card__title">
              <a href="{{ other.url }}">{{ other.data.title }}</a>
            </h3>
            <p class="news-card__excerpt">{{ other.data.excerpt or other.templateContent | truncate(150) }}</p>
            <a href="{{ other.url }}" class="news-card__link">Читать далее →</a>
          </article>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
