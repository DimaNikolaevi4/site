---
layout: layouts/base.njk
permalink: false
eleventyExcludeFromCollections: true
pagination:
  data: collections.news
  size: 1
  alias: post
---

<!-- Хлебные крошки -->
<nav class="breadcrumbs" aria-label="Хлебные крошки">
  <div class="container">
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a href="/" class="breadcrumbs__link">Главная</a>
      </li>
      <li class="breadcrumbs__item">
        <a href="/news/" class="breadcrumbs__link">Новости</a>
      </li>
      <li class="breadcrumbs__item breadcrumbs__item--active" aria-current="page">
        {{ post.data.title }}
      </li>
    </ol>
  </div>
</nav>

<!-- Заголовок новости -->
<section class="section section--header">
  <div class="container">
    <h1 class="page-title">{{ post.data.title }}</h1>
    <div class="material-meta">
      <time class="material-meta__date" datetime="{{ post.date }}">
        {{ post.date | dateRu }}
      </time>
      {% if post.data.category %}
      <span class="material-meta__category">{{ post.data.category }}</span>
      {% endif %}
    </div>
  </div>
</section>

<!-- Основной контент -->
<div class="container layout">
  <main class="layout__content layout__content--full news-content">
    {{ post.templateContent | safe }}
  </main>
</div>

<!-- Другие новости -->
{# Фильтр «нет картинки → не выводим»: новости без image пропускаем,
   берём следующие свежие, исключая текущую. #}
{% set _otherNews = [] %}
{% for other in collections.news | reverse %}
  {% if other.url != post.url and other.data.image and _otherNews.length < 3 %}
    {% set _otherNews = (_otherNews.push(other), _otherNews) %}
  {% endif %}
{% endfor %}
{% if _otherNews.length > 0 %}
<section class="section">
  <div class="container">
    <h2 class="section-title">Другие новости</h2>
    <div class="news-grid">
      {% for other in _otherNews %}
      <article class="news-card">
        <img src="{{ other.data.image }}" class="news-card__image img-fluid" alt="{{ other.data.title }}" loading="lazy">
        <time class="news-card__date" datetime="{{ other.date }}">{{ other.date | dateRu }}</time>
        <h3 class="news-card__title">
          <a href="{{ other.url }}">{{ other.data.title }}</a>
        </h3>
        <p class="news-card__excerpt">{{ other.data.excerpt or other.templateContent | truncate(150) }}</p>
        <a href="{{ other.url }}" class="read-more" aria-label="Читать полностью — {{ other.data.title }}">
          <span>Читать полностью</span>
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
