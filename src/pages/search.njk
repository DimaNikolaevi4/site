---
layout: layouts/base.njk
title: Поиск
description: Поиск по сайту ГБПОУ РО «Сальский индустриальный техникум»
permalink: /search/
---

{# Секция Hero #}
{% include "components/hero.njk" %}

{# Контекст страницы #}
<div class="container container--breadcrumbs">
  {% include "components/breadcrumbs.njk" %}
</div>

<!-- Основной контент -->
<div class="container layout">
  <main class="layout__content layout__content--full search-page" id="main-content">
    <!-- Форма поиска -->
    <form class="search-form" role="search" action="/search/" method="get">
      <div class="search-form__group">
        <input
          type="search"
          class="search-form__input"
          name="q"
          value=""
          placeholder="Введите запрос для поиска..."
          aria-label="Поисковый запрос"
          required
          autocomplete="off"
        >
        <button type="submit" class="btn btn-primary btn-lg">Найти</button>
      </div>
    </form>

    <!-- Результаты поиска (скрыты до выполнения поиска) -->
    <div class="search-results" style="display: none;">
      <p class="search-results__info"></p>
      <ul class="search-results__list"></ul>
    </div>

    <!-- Подсказки для поиска (показываются до поиска) -->
    <div class="search-tips">
      <h2 class="search-tips__title">Советы по поиску</h2>
      <ul class="search-tips__list">
        <li>Используйте ключевые слова для более точного поиска</li>
        <li>Можно искать по названию, содержанию или тегам</li>
        <li>Для поиска точной фразы используйте кавычки: "профессиональное образование"</li>
        <li>Поиск работает по русским и английским словам</li>
      </ul>
    </div>
  </main>
</div>

{# Подключаем Lunr.js и скрипт поиска #}
<script src="https://unpkg.com/lunr@2.3.9/lunr.min.js" defer></script>
<script src="https://unpkg.com/lunr-languages@1.14.0/lunr.stemmer.support.js" defer></script>
<script src="https://unpkg.com/lunr-languages@1.14.0/lunr.ru.js" defer></script>
<script src="/assets/js/search.js" defer></script>

<style>
.search-page {
  padding: 2rem 0 4rem;
}

.search-form {
  margin-bottom: 2rem;
}

.search-form__group {
  display: flex;
  gap: 1rem;
  max-width: 600px;
}

.search-form__input {
  flex: 1;
  padding: 0.75rem 1rem;
  font-size: 1.125rem;
  border: 2px solid #dee2e6;
  border-radius: 0.5rem;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.search-form__input:focus {
  outline: none;
  border-color: var(--color-primary, #2e7d32);
  box-shadow: 0 0 0 3px rgba(46, 125, 50, 0.15);
}

.search-results {
  margin-top: 2rem;
}

.search-results__info {
  font-size: 1.125rem;
  color: #6c757d;
  margin-bottom: 1.5rem;
}

.search-results__list {
  list-style: none;
  padding: 0;
  margin: 0;
}

.search-result-card {
  background: #fff;
  border: 1px solid #e9ecef;
  border-radius: 0.5rem;
  padding: 1.5rem;
  margin-bottom: 1rem;
  transition: box-shadow 0.2s;
}

.search-result-card:hover {
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.search-result-card__title {
  font-size: 1.25rem;
  margin: 0 0 0.5rem 0;
}

.search-result-card__title a {
  color: var(--color-primary, #2e7d32);
  text-decoration: none;
}

.search-result-card__title a:hover {
  text-decoration: underline;
}

.search-result-card__meta {
  display: flex;
  gap: 1rem;
  font-size: 0.875rem;
  color: #6c757d;
  margin-bottom: 0.5rem;
}

.search-result-card__category {
  background: #e9ecef;
  padding: 0.125rem 0.5rem;
  border-radius: 0.25rem;
}

.search-result-card__excerpt {
  color: #495057;
  line-height: 1.5;
  margin: 0;
}

.search-result-card__excerpt mark {
  background: #fff3cd;
  padding: 0.125rem 0.25rem;
  border-radius: 0.125rem;
}

.search-tips {
  background: #f8f9fa;
  border-radius: 0.5rem;
  padding: 1.5rem;
  margin-top: 2rem;
}

.search-tips__title {
  font-size: 1.125rem;
  margin: 0 0 1rem 0;
}

.search-tips__list {
  margin: 0;
  padding-left: 1.25rem;
}

.search-tips__list li {
  margin-bottom: 0.5rem;
  color: #495057;
}

/* Тёмная тема */
html.dark-theme .search-result-card {
  background: #1a1a1a;
  border-color: #333;
}

html.dark-theme .search-form__input {
  background: #1a1a1a;
  border-color: #444;
  color: #fff;
}

html.dark-theme .search-tips {
  background: #1a1a1a;
}

html.dark-theme .search-result-card__excerpt mark {
  background: #5c4a1f;
}
</style>
