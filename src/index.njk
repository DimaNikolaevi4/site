---
layout: layouts/base.njk
title: Главная страница
description: Официальный сайт Сальского индустриального техникума
---

{#
  Главная страница — 7 секций:
    Секция 1: Header           — глобально, в base.njk
    Секция 2: Hero             — components/hero.njk
    Секция 3: About            — components/about.njk (слово директора)
    Секция 4: Контент+Сайдбар  — сетка 70/30: новости + сайдбар (заглушка)
    Секция 5: Популярное       — components/popular.njk (заглушка)
    Секция 6: (резерв)         — место под будущий блок
    Секция 7: Footer           — глобально, в base.njk

  На главной хлебные крошки НЕ выводятся — они только на внутренних страницах.
#}

<main class="main">

  <!-- ═══════════════════════════════════════════════ -->
  <!-- Секция 2 — Hero                                 -->
  <!-- ═══════════════════════════════════════════════ -->
  {% set hideRubric = true %}
  {% include "components/hero.njk" %}

  {# ═══════════════════════════════════════════════════════════
     Объединённое визуальное пространство для секций 3–6.
     Один общий декоративный SVG-фон (bg-02 для светлой темы,
     bg-03 — для тёмной), под ним прозрачные секции.
     ═══════════════════════════════════════════════════════════ #}
  <div class="home-bg">

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Секция 3 — About (слово директора)              -->
    <!-- ═══════════════════════════════════════════════ -->
    {% set aboutMode = 'director' %}
    {% include "components/about.njk" %}

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Секция 4 — Контент + Сайдбар (70% / 30%)        -->
    <!-- Лента новостей + сайдбар с едиными баннерами    -->
    <!-- ═══════════════════════════════════════════════ -->
    <section id="news" class="courses section">

      <div class="container section-title" data-aos="fade-up">
        <h2>Новости</h2>
        <p>Последние события техникума</p>
      </div>

      <div class="container">
        <div class="content-sidebar-grid">

          <!-- Сайдбар (30% слева) — единые баннеры, заглушка -->
          <div class="sidebar-col">
            {% include "components/sidebar.njk" %}
          </div>

          <!-- Лента новостей (70% справа) — 3 последние через news.njk -->
          {% set newsMode = 'latest' %}
          {% set newsInline = true %}
          {% set newsCount = 3 %}
          {% include "components/news.njk" %}

        </div>
      </div>

    </section>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Секция 5 — Популярные разделы (заглушка)        -->
    <!-- ═══════════════════════════════════════════════ -->
    {% include "components/popular.njk" %}

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Секция 6 — Резерв (место под будущий блок)      -->
    <!-- ═══════════════════════════════════════════════ -->
    {# Здесь появится дополнительная секция, пока пусто. #}

  </div>

</main>
