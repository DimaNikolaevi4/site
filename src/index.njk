layout: layouts/base.njk
title: Главная страница
description: Официальный сайт Сальского индустриального техникума
hideRubric: true
---

{#
  Главная страница — 8 секций (STRUCTURE 3.2 / 3.3):
    Секция 1: Header           — глобально, в base.njk
    Секция 2: Hero             — components/hero.njk (в base.njk)
    Секция 3: About            — components/about.njk (слово директора)
    Секция 4: Хлебные крошки   — пропущена на главной (только на внутренних)
    Секция 5: Материалы        — components/news.njk (самостоятельный блок)
    Секция 6: Популярное       — components/popular.njk
    Секция 7: Сайдбар          — components/sidebar.njk (сквозная колонка ~30%)
    Секция 8: Footer           — глобально, в base.njk
#}

<div class="main">

  <!-- ═══════════════════════════════════════════════ -->
  <!-- Секция 1 — Header рендерится в base.njk         -->
  <!-- ═══════════════════════════════════════════════ -->

  <!-- ═══════════════════════════════════════════════ -->
  <!-- Секция 2 — Hero рендерится в base.njk           -->
  <!-- (hideRubric: true задан во frontmatter)         -->
  <!-- ═══════════════════════════════════════════════ -->

  {# ═══════════════════════════════════════════════════════════
     Объединённое визуальное пространство для секций 3, 5, 6, 7.
     Один общий декоративный SVG-фон (bg-02 для светлой темы,
     bg-03 — для тёмной), под ним прозрачные секции.
     ═══════════════════════════════════════════════════════════ #}
  <div class="home-bg">

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Секция 3 — About (слово директора)              -->
    <!-- ═══════════════════════════════════════════════ -->
    {% set aboutMode = 'director' %}
    {% include "components/about.njk" %}

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Секция 4 — Хлебные крошки                       -->
    <!-- На главной не выводятся (только на внутренних). -->
    <!-- ═══════════════════════════════════════════════ -->

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Секция 5 — Материалы (лента новостей)           -->
    <!-- Самостоятельный блок, без сайдбара внутри.      -->
    <!-- ═══════════════════════════════════════════════ -->
    <section id="news" class="courses section">

      <div class="container section-title" data-aos="fade-up">
        <h2>Новости</h2>
        <p>Последние события техникума</p>
      </div>

      <div class="container">
        <div class="content-sidebar-grid">

          <!-- Сайдбар (Секция 7) — сквозная колонка ~30% слева -->
          <div class="sidebar-col">
            {% include "components/sidebar.njk" %}
          </div>

          <!-- Лента новостей (~70% справа) — 3 последние через news.njk -->
          {% set newsMode = 'latest' %}
          {% set newsInline = true %}
          {% set newsCount = 3 %}
          {% include "components/news.njk" %}

        </div>
      </div>

    </section>

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Секция 6 — Популярные разделы                   -->
    <!-- ═══════════════════════════════════════════════ -->
    {% include "components/popular.njk" %}

    <!-- ═══════════════════════════════════════════════ -->
    <!-- Секция 7 — Сайдбар                              -->
    <!-- Сквозная колонка ~30% (см. сетку в Секции 5).   -->
    <!-- Доработка сквозной колонки — задача 3.3.2.4.    -->
    <!-- ═══════════════════════════════════════════════ -->

  </div>

  <!-- ═══════════════════════════════════════════════ -->
  <!-- Секция 8 — Footer рендерится в base.njk         -->
  <!-- ═══════════════════════════════════════════════ -->

</div>
